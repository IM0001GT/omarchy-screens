#!/usr/bin/env python3
"""Read and apply Hyprland display layout for the Screens bar panel.

Commands:
  state              JSON snapshot of monitors + saved profiles
  apply [--preview] <json>  write monitors.lua and reload
  confirm            keep a previewed layout (cancel the 10s revert)
  revert             restore the layout from before the last preview
  enable <name>      turn a disabled connected output back on
  unmirror           clear mirrors and restore the last saved desk
  identify [name]    flash a Hyprland notify (panel Find uses its own overlay)
  profile save <name> [json]   store a hardware-aware layout
  profile delete <name>
  profile apply <name>
  profile auto 0|1
  profile primary <identity>
  workspaces on|off|sync|auto|assign <json>|plan
  workspace-layout <id> tile|scroll|float
  workspace-label <id> [name] [icon]
  idle off|on|notice
  backup-original    snapshot stock files once, before Screens writes them
  restore-original   put those first snapshots back and reload Hyprland
  claim              backup leftover config, take over monitors.lua, restore scale keys, install workspaces plugin
  recover-internal   re-enable the laptop panel if it is the last remaining output
  conflicts [check|unmanage|remove|keep]  hyprmoncfg / HyprMod handoff
  bar-care <key> <value>  persist bar dim / hover lift
  scale up|down|N    step focused-display scale
  scale-keys take|skip|alt|set <up> <down>  keep, skip, or change scale keybinds
"""

