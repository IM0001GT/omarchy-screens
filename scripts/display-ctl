def run(cmd, timeout=4):
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def hypr_json(args):
    out = run(["hyprctl", "-j", *args])
    if not out or out.returncode != 0 or not (out.stdout or "").strip():
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def lua_str(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def refresh_label(hz):
    try:
        hz = float(hz)
    except (TypeError, ValueError):
        return ""
    nearest = round(hz)
    if abs(hz - nearest) < 0.05:
        return "%d Hz" % nearest
    return ("%.2f" % hz).rstrip("0").rstrip(".") + " Hz"


def parse_mode(raw):
    text = str(raw or "").strip()
    text = re.sub(r"Hz$", "", text, flags=re.I)
    m = re.match(r"(\d+)x(\d+)@([\d.]+)$", text)
    if not m:
        return None
    w, h, hz = int(m.group(1)), int(m.group(2)), float(m.group(3))
    return {
        "id": "%dx%d@%s" % (w, h, m.group(3)),
        "width": w,
        "height": h,
        "refresh": hz,
        "resolution": "%dx%d" % (w, h),
        "label": "%d × %d" % (w, h),
        "refreshLabel": refresh_label(hz),
    }


def logical_size(width, height, scale, transform):
    try:
        scale = float(scale) if scale else 1.0
    except (TypeError, ValueError):
        scale = 1.0
    if scale <= 0:
        scale = 1.0
    w = int(round(float(width or 0) / scale))
    h = int(round(float(height or 0) / scale))
    if int(transform or 0) in (1, 3, 5, 7):
        w, h = h, w
    return max(1, w), max(1, h)


def detected_label(mon):
    model = " ".join((mon.get("model") or "").split())
    if model:
        return model
    return mon.get("name") or "Display"


def drm_edid_path(name):
    matches = sorted(glob.glob("/sys/class/drm/card*-%s/edid" % name))
    return matches[0] if matches else None


def decode_hdr_max_nits(cv):
    if not cv:
        return None
    return int(round(50.0 * (2.0 ** (cv / 32.0))))


def decode_hdr_min_nits(cv, max_nits):
    if not cv or not max_nits:
        return None
    return float(max_nits) * ((cv / 255.0) ** 2) / 100.0


def edid_caps(name):
    path = drm_edid_path(name)
    caps = {
        "hdr": False,
        "vrr": False,
        "bitdepth": 10,
        "wide_gamut": False,
        "min_luminance": None,
        "max_luminance": None,
        "max_avg_luminance": None,
    }
    if not path:
        return caps
    try:
        data = open(path, "rb").read()
    except OSError:
        return caps
    if len(data) < 128:
        return caps

    hdmi_vsdb = False
    hdmi_deep = False

    def walk(block):
        nonlocal hdmi_vsdb, hdmi_deep
        if len(block) < 5 or block[0] != 0x02:
            return
        dtd = block[2]
        i = 4
        end = min(dtd if dtd >= 4 else len(block), len(block))
        while i < end:
            header = block[i]
            if header == 0:
                break
            tag = header >> 5
            length = header & 0x1F
            payload = block[i + 1 : i + 1 + length]
            i += 1 + length
            if tag == 7 and payload:
                ext = payload[0]
                # 6 = HDR static metadata, 7 = HDR dynamic metadata
                if ext in (6, 7):
                    caps["hdr"] = True
                if ext == 6 and len(payload) >= 4:
                    mx = decode_hdr_max_nits(payload[3])
                    if mx:
                        caps["max_luminance"] = mx
                    if len(payload) >= 5:
                        avg = decode_hdr_max_nits(payload[4])
                        if avg:
                            caps["max_avg_luminance"] = avg
                    if len(payload) >= 6:
                        mn = decode_hdr_min_nits(payload[5], caps["max_luminance"])
                        if mn is not None:
                            caps["min_luminance"] = mn
                # 14 = HDMI Forum SCDB (VRR)
                # 5 = colorimetry (BT2020 bits 0–2)
                if ext == 5 and len(payload) >= 2 and payload[1] & 0x07:
                    caps["wide_gamut"] = True
                if ext == 0x0E:
                    caps["vrr"] = True
            if tag == 3 and len(payload) >= 3:
                oui = (payload[0] << 16) | (payload[1] << 8) | payload[2]
                # HDMI Forum VSDB, AMD FreeSync
                if oui in (0xC45DD8, 0x00001A):
                    caps["vrr"] = True
                if oui == 0xC45DD8:
                    caps["bitdepth"] = 10
                # HDMI 1.4 VSDB: byte 6 carries deep-color flags.
                if oui == 0x000C03:
                    hdmi_vsdb = True
                    if len(payload) >= 7 and payload[6] & 0x70:
                        hdmi_deep = True
                        # DC_48 = 16-bit, DC_36 = 12-bit (Dolby Vision), DC_30 = 10-bit.
                        # Hyprland only honors 8 vs 10 on the wire; 12/16 stay in Screens.
                        if payload[6] & 0x40:
                            caps["bitdepth"] = 16
                        elif payload[6] & 0x20:
                            caps["bitdepth"] = 12
                        else:
                            caps["bitdepth"] = 10

    walk(data[128:256] if len(data) >= 256 else b"")
    if len(data) >= 384:
        walk(data[256:384])
    if len(data) >= 512:
        walk(data[384:512])
    if b"freesync" in data.lower() or b"adaptive-sync" in data.lower():
        caps["vrr"] = True
    # HDMI VSDB with no DC_30/36/48 flag is a strong 8-bit-only signal.
    # DP/eDP often omit that block; those stay on 10-bit when HDR is present.
    if hdmi_vsdb and not hdmi_deep:
        caps["bitdepth"] = 8
    return caps


def current_mode_id(mon):
    w = int(mon.get("width") or 0)
    h = int(mon.get("height") or 0)
    hz = float(mon.get("refreshRate") or 0)
    if w <= 0 or h <= 0:
        return ""
    modes = []
    for raw in mon.get("availableModes") or []:
        parsed = parse_mode(raw)
        if parsed and parsed["width"] == w and parsed["height"] == h:
            modes.append(parsed)
    if not modes:
        return "%dx%d@%s" % (w, h, ("%g" % hz) if hz else "60")
    best = min(modes, key=lambda p: abs(p["refresh"] - hz))
    return best["id"]


def vrr_mode(mon):
    raw = mon.get("vrr")
    if raw is True:
        return 1
    if raw is False or raw is None:
        return 0
    try:
        return int(raw)
    except (TypeError, ValueError):
        return 0


def parse_lua_monitors(text):
    found = {}
    for block in re.findall(r"hl\.monitor\(\{\s*(.*?)\s*\}\)", text or "", re.S):
        out = re.search(r'output\s*=\s*"([^"]+)"', block)
        if not out or not out.group(1):
            continue
        entry = {}
        m = re.search(r"vrr\s*=\s*(\d+)", block)
        if m:
            entry["vrr"] = int(m.group(1))
        m = re.search(r"bitdepth\s*=\s*(\d+)", block)
        if m:
            entry["bitdepth"] = int(m.group(1))
        m = re.search(r'cm\s*=\s*"([^"]+)"', block)
        if m:
            entry["cm"] = m.group(1)
        m = re.search(r"sdr_min_luminance\s*=\s*([0-9.]+)", block)
        if m:
            entry["sdrMinLuminance"] = float(m.group(1))
        m = re.search(r"sdr_max_luminance\s*=\s*([0-9.]+)", block)
        if m:
            entry["sdrMaxLuminance"] = int(float(m.group(1)))
        m = re.search(r"sdrbrightness\s*=\s*([0-9.]+)", block)
        if m:
            entry["sdrBrightness"] = float(m.group(1))
        m = re.search(r"sdrsaturation\s*=\s*([0-9.]+)", block)
        if m:
            entry["sdrSaturation"] = float(m.group(1))
        m = re.search(r'sdr_eotf\s*=\s*"([^"]+)"', block)
        if m:
            entry["sdrEotf"] = m.group(1)
        m = re.search(r"max_avg_luminance\s*=\s*([0-9.]+)", block)
        if m:
            entry["maxAvgLuminance"] = int(float(m.group(1)))
        m = re.search(r"supports_wide_color\s*=\s*(-?\d+)", block)
        if m:
            entry["supportsWideColor"] = int(m.group(1))
        m = re.search(r"(?<![a-z_])min_luminance\s*=\s*([0-9.]+)", block)
        if m:
            entry["minLuminance"] = float(m.group(1))
        m = re.search(r"(?<![a-z_])max_luminance\s*=\s*([0-9.]+)", block)
        if m:
            entry["maxLuminance"] = int(float(m.group(1)))
        cm = entry.get("cm") or ""
        supports = bool(re.search(r"supports_hdr\s*=\s*1", block))
        if cm in ("hdr", "hdredid"):
            entry["hdrMode"] = 2
        elif supports:
            entry["hdrMode"] = 1
        found[out.group(1)] = entry
    return found


def lua_rule_for(entry, lua_rules):
    keys = [
        entry.get("identity") or "",
        entry.get("name") or "",
    ]
    desc = clean_desc(entry.get("description") or "")
    if desc:
        keys.append("desc:%s" % desc)
    for key in keys:
        if key and key in lua_rules:
            return lua_rules[key]
    return {}


def read_monitors_lua():
    try:
        with open(MONITORS_LUA, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def is_hdr(mon):
    cm = str(mon.get("colorManagementPreset") or "").lower()
    fmt = str(mon.get("currentFormat") or "").upper()
    if cm in ("hdr", "hdredid"):
        return True
    if any(tok in fmt for tok in ("2101010", "101010", "P010", "P012")):
        return True
    return False


def group_resolutions(modes):
    grouped = []
    index = {}
    for mode in modes:
        key = mode["resolution"]
        if key not in index:
            index[key] = {
                "id": key,
                "label": mode["label"],
                "width": mode["width"],
                "height": mode["height"],
                "refreshes": [],
            }
            grouped.append(index[key])
        refresh = {
            "id": mode["id"],
            "refresh": mode["refresh"],
            "label": mode["refreshLabel"],
        }
        if all(r["id"] != refresh["id"] for r in index[key]["refreshes"]):
            index[key]["refreshes"].append(refresh)
    for item in grouped:
        item["refreshes"].sort(key=lambda r: -r["refresh"])
    grouped.sort(key=lambda r: (-r["width"], -r["height"]))
    return grouped


def layout_hints(store, match_name):
    hints = {}

    def absorb(entries):
        for entry in entries or []:
            if isinstance(entry, dict) and entry.get("id"):
                hints[entry["id"]] = entry

    absorb(store.get("lastLayout"))
    if hints:
        return hints
    profile = find_profile(store, store.get("active") or "") or find_profile(
        store, match_name or ""
    )
    if profile:
        absorb(profile.get("monitors"))
    return hints


def rects_overlap(a, b):
    return (
        a["x"] < b["x"] + b["logicalW"]
        and a["x"] + a["logicalW"] > b["x"]
        and a["y"] < b["y"] + b["logicalH"]
        and a["y"] + a["logicalH"] > b["y"]
    )


def restore_disabled_geometry(monitors, hints):
    if not hints:
        return
    dx = dy = 0
    for mon in monitors:
        if not mon.get("enabled"):
            continue
        rule = hints.get(mon.get("identity") or "")
        if rule and "x" in rule:
            dx = int(mon.get("x") or 0) - int(rule.get("x") or 0)
            dy = int(mon.get("y") or 0) - int(rule.get("y") or 0)
            break
    for entry in monitors:
        if entry.get("enabled"):
            continue
        rule = hints.get(entry.get("identity") or "")
        if not rule:
            continue
        if "x" in rule:
            entry["x"] = int(rule.get("x") or 0) + dx
        if "y" in rule:
            entry["y"] = int(rule.get("y") or 0) + dy
        if (not entry.get("width") or not entry.get("height")) and rule.get("mode"):
            parsed = parse_mode(rule["mode"])
            if parsed:
                entry["mode"] = rule["mode"]
                entry["width"] = parsed["width"]
                entry["height"] = parsed["height"]
                entry["refresh"] = parsed["refresh"]
        if "scale" in rule:
            entry["scale"] = rule["scale"]
        if "transform" in rule:
            entry["transform"] = int(rule.get("transform") or 0)
        entry["logicalW"], entry["logicalH"] = logical_size(
            entry.get("width"),
            entry.get("height"),
            entry.get("scale"),
            entry.get("transform"),
        )


def park_disabled(monitors):
    enabled = [m for m in monitors if m.get("enabled")]
    if not enabled:
        return
    cursor_x = max(m["x"] + m["logicalW"] for m in enabled)
    cursor_y = min(m["y"] for m in enabled)
    for mon in monitors:
        if mon.get("enabled"):
            continue
        mon["x"] = cursor_x
        mon["y"] = cursor_y
        cursor_x += mon["logicalW"]


def drm_connected_names():
    names = []
    for path in sorted(glob.glob("/sys/class/drm/card*-*/status")):
        try:
            status = open(path, encoding="utf-8").read().strip()
        except OSError:
            continue
        if status != "connected":
            continue
        base = os.path.basename(os.path.dirname(path))
        name = re.sub(r"^card\d+-", "", base)
        if not name or name.startswith("Writeback"):
            continue
        if name not in names:
            names.append(name)
    return names


def stub_monitor(name):
    entry = {
        "name": name,
        "description": "",
        "make": "",
        "model": "",
        "label": name,
        "enabled": False,
        "focused": False,
        "width": 1920,
        "height": 1080,
        "refresh": 60,
        "x": 0,
        "y": 0,
        "scale": 1,
        "transform": 0,
        "vrr": 0,
        "cm": "srgb",
        "format": "",
        "hdr": False,
        "hdrMode": 0,
        "hdrCapable": False,
        "vrrCapable": False,
        "bitdepth": 8,
        "bitdepthCapable": 8,
        "sdrMinLuminance": 0.2,
        "sdrMaxLuminance": 80,
        "sdrBrightness": 1.0,
        "sdrSaturation": 1.0,
        "sdrEotf": "default",
        "wideGamut": False,
        "minLuminance": -1,
        "maxLuminance": -1,
        "maxAvgLuminance": -1,
        "logicalW": 1920,
        "logicalH": 1080,
        "mode": "preferred",
        "resolutions": [],
        "physicalW": 0,
        "physicalH": 0,
        "mirror": "",
    }
    entry["identity"] = name
    return entry


def merge_drm_connected(monitors):
    have = {m.get("name") for m in monitors}
    for name in drm_connected_names():
        if name not in have:
            monitors.append(stub_monitor(name))


def snapshot():
    raw = hypr_json(["monitors", "all"]) or []
    monitors = []
    for mon in raw:
        name = mon.get("name") or ""
        modes = [p for p in (parse_mode(x) for x in mon.get("availableModes") or []) if p]
        scale = mon.get("scale") or 1
        transform = int(mon.get("transform") or 0)
        width = int(mon.get("width") or 0)
        height = int(mon.get("height") or 0)
        lw, lh = logical_size(width, height, scale, transform)
        caps = edid_caps(name)
        edid_hdr = bool(caps.get("hdr"))
        hdr_on = is_hdr(mon)
        if vrr_mode(mon):
            caps["vrr"] = True
        if not caps["vrr"] and any(p["refresh"] >= 100 for p in modes):
            caps["vrr"] = True
        fmt = str(mon.get("currentFormat") or "").upper()
        if "16161616" in fmt:
            caps["bitdepth"] = max(int(caps.get("bitdepth") or 8), 16)
        elif "P012" in fmt or "121212" in fmt:
            caps["bitdepth"] = max(int(caps.get("bitdepth") or 8), 12)
        elif any(tok in fmt for tok in ("2101010", "101010", "P010")):
            caps["bitdepth"] = max(int(caps.get("bitdepth") or 8), 10)
        mirror = mon.get("mirrorOf") or ""
        if mirror == "none":
            mirror = ""
        vrr = vrr_mode(mon)
        cm = mon.get("colorManagementPreset") or "srgb"
        bitdepth = clean_bitdepth(caps.get("bitdepth"), 8)
        if hdr_on and any(tok in fmt for tok in ("XRGB8888", "XR24", "AR24")):
            bitdepth = 8
        sdr_min = mon.get("sdrMinLuminance")
        sdr_max = mon.get("sdrMaxLuminance")
        try:
            sdr_min = float(sdr_min) if sdr_min is not None else 0.2
        except (TypeError, ValueError):
            sdr_min = 0.2
        try:
            sdr_max = int(float(sdr_max)) if sdr_max is not None else 80
        except (TypeError, ValueError):
            sdr_max = 80
        sdr_bright = mon.get("sdrBrightness")
        try:
            sdr_bright = float(sdr_bright) if sdr_bright is not None else 1.0
        except (TypeError, ValueError):
            sdr_bright = 1.0
        sdr_sat = mon.get("sdrSaturation")
        try:
            sdr_sat = float(sdr_sat) if sdr_sat is not None else 1.0
        except (TypeError, ValueError):
            sdr_sat = 1.0
        entry = {
            "name": name,
            "description": mon.get("description") or "",
            "make": mon.get("make") or "",
            "model": mon.get("model") or "",
            "label": detected_label(mon),
            "enabled": not bool(mon.get("disabled")),
            "focused": bool(mon.get("focused")),
            "width": width,
            "height": height,
            "refresh": float(mon.get("refreshRate") or 0),
            "x": int(mon.get("x") or 0),
            "y": int(mon.get("y") or 0),
            "scale": float(scale),
            "transform": transform,
            "vrr": vrr,
            "cm": cm,
            "format": mon.get("currentFormat") or "",
            "hdr": hdr_on,
            "hdrMode": 2 if hdr_on else 0,
            "hdrCapable": edid_hdr,
            "vrrCapable": caps["vrr"],
            "bitdepth": bitdepth,
            "bitdepthCapable": clean_bitdepth(caps.get("bitdepth"), 8),
            "sdrMinLuminance": sdr_min,
            "sdrMaxLuminance": sdr_max,
            "sdrBrightness": sdr_bright,
            "sdrSaturation": sdr_sat,
            "sdrEotf": "default",
            "supportsWideColor": 0,
            "wideGamut": bool(caps.get("wide_gamut")),
            "minLuminance": caps["min_luminance"] if caps["min_luminance"] is not None else -1,
            "maxLuminance": caps["max_luminance"] if caps["max_luminance"] is not None else -1,
            "maxAvgLuminance": caps["max_avg_luminance"] if caps["max_avg_luminance"] is not None else -1,
            "logicalW": lw,
            "logicalH": lh,
            "mode": current_mode_id(mon),
            "resolutions": group_resolutions(modes),
            "physicalW": int(mon.get("physicalWidth") or 0),
            "physicalH": int(mon.get("physicalHeight") or 0),
            "mirror": mirror,
        }
        entry["identity"] = monitor_identity(entry)
        monitors.append(entry)
    lua_rules = parse_lua_monitors(read_monitors_lua())
    store_early = load_store()
    layout_by_id = layout_map(store_early.get("lastLayout"))
    for entry in monitors:
        saved = layout_by_id.get(entry.get("identity") or "") or {}
        for key in (
            "bitdepth", "cm", "hdrMode", "sdrMinLuminance", "sdrMaxLuminance",
            "sdrBrightness", "sdrSaturation", "sdrEotf", "supportsWideColor",
            "textPx", "minLuminance",
            "maxLuminance", "maxAvgLuminance",
        ):
            if key in saved and saved[key] not in (None, ""):
                entry[key] = saved[key]
        rule = lua_rule_for(entry, lua_rules)
        if "vrr" in rule:
            entry["vrr"] = rule["vrr"]
        for key in (
            "bitdepth", "cm", "hdrMode", "sdrMinLuminance", "sdrMaxLuminance",
            "sdrBrightness", "sdrSaturation", "sdrEotf", "supportsWideColor",
            "textPx", "minLuminance",
            "maxLuminance", "maxAvgLuminance",
        ):
            if key in rule:
                entry[key] = rule[key]
        mode = hdr_mode(entry)
        if not entry.get("hdrCapable"):
            mode = 0
        entry["hdrMode"] = mode
        entry["hdr"] = mode == 2
    merge_drm_connected(monitors)
    if internal_toggle_active():
        for entry in monitors:
            if is_internal_panel(entry):
                entry["enabled"] = False
    ensure_original_backup()
    store = load_store()
    ids = [m["identity"] for m in monitors if m.get("identity")]
    match = match_profile(store, ids)
    restore_disabled_geometry(monitors, layout_hints(store, match))
    park_disabled(monitors)
    monitors.sort(key=lambda m: (not m["enabled"], m["x"], m["y"], m["name"]))
    drm = drm_outputs()
    primary_drv = primary_drivers(drm)
    hybrid = hybrid_gpus(drm)
    by_drm = {e["name"]: e for e in drm}
    for entry in monitors:
        info = by_drm.get(entry.get("name") or "") or {}
        drv = info.get("driver") or ""
        entry["secondaryGpu"] = bool(hybrid and drv and drv not in primary_drv)
    primary = store.get("primary") or ""
    if not primary:
        focused = next((m for m in monitors if m.get("focused")), None)
        if focused and focused.get("identity"):
            primary = focused["identity"]
            store["primary"] = primary
            save_store(store)
    if primary and not any(m.get("identity") == primary for m in monitors):
        primary = ""
    return {
        "monitors": monitors,
        "profiles": [
            {"name": p.get("name") or "", "count": len(p.get("monitors") or [])}
            for p in store.get("profiles") or []
            if p.get("name")
        ],
        "active": store.get("active") or "",
        "autoSwitch": bool(store.get("autoSwitch", True)),
        "match": match or "",
        "primary": primary,
        "connectedKey": "\n".join(sorted(ids)),
        "hybridGpus": hybrid_gpus(),
        "hybridNotice": hybrid_gpus() and not store.get("hybridNoticeShown"),
        "manageWorkspaces": bool(store.get("manageWorkspaces")),
        "workspacePlan": plan_for_write(monitors) if store.get("manageWorkspaces") else [],
        "workspaceLayouts": store.get("workspaceLayouts") or {},
        "conflict": public_conflict(detect_conflicts()),
        "claimedMonitors": bool(store.get("claimedMonitors")),
        "barCare": normalize_bar_care(store.get("barCare")),
        "oledGuard": os.path.isdir(OLED_GUARD_PLUGIN_DIR),
        "pendingRevert": store.get("pendingRevert") or None,
        "scaleKeys": public_scale_keys(store.get("scaleKeys")),
    }


def read_gdk_scale(text):
    m = re.search(r"omarchy_gdk_scale\s*=\s*([0-9.]+)", text or "")
    if m:
        return m.group(1)
    return "2"


def clean_desc(text):
    desc = (text or "").strip()
    return re.sub(r"\s+\([^)]+\)$", "", desc)


def monitor_identity(mon):
    desc = clean_desc(mon.get("description") or mon.get("id") or "")
    if desc.startswith("desc:"):
        return desc
    if desc:
        return "desc:%s" % desc
    return mon.get("name") or ""


def connected_key(monitors):
    return "\n".join(sorted({monitor_identity(m) for m in monitors if monitor_identity(m)}))


def load_store():
    store = {
        "active": "",
        "autoSwitch": True,
        "lastKey": "",
        "primary": "",
        "profiles": [],
        "lastLayout": [],
        "deskLayout": [],
        "hybridNoticeShown": False,
        "claimedMonitors": False,
        "hyprmoncfgChoiceSeen": False,
        "manageWorkspaces": False,
        "workspaceLayouts": {},
        "workspacesBarId": "",
    }
    try:
        with open(PROFILES_PATH, encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            store["active"] = str(data.get("active") or "")
            store["autoSwitch"] = bool(data.get("autoSwitch", True))
            store["lastKey"] = str(data.get("lastKey") or "")
            store["primary"] = str(data.get("primary") or "")
            profiles = data.get("profiles")
            if isinstance(profiles, list):
                store["profiles"] = profiles
            last_layout = data.get("lastLayout")
            if isinstance(last_layout, list):
                store["lastLayout"] = last_layout
            desk_layout = data.get("deskLayout")
            if isinstance(desk_layout, list):
                store["deskLayout"] = desk_layout
            store["hybridNoticeShown"] = bool(data.get("hybridNoticeShown"))
            store["claimedMonitors"] = bool(data.get("claimedMonitors"))
            store["hyprmoncfgChoiceSeen"] = bool(data.get("hyprmoncfgChoiceSeen"))
            store["manageWorkspaces"] = bool(data.get("manageWorkspaces"))
            layouts = data.get("workspaceLayouts")
            if isinstance(layouts, dict):
                cleaned = {}
                for key, value in layouts.items():
                    mode = clean_workspace_layout(value)
                    if mode:
                        cleaned[str(key)] = mode
                store["workspaceLayouts"] = cleaned
            store["workspacesBarId"] = str(data.get("workspacesBarId") or "")
            store["barCare"] = normalize_bar_care(data.get("barCare"))
            store["scaleKeys"] = data.get("scaleKeys") if isinstance(data.get("scaleKeys"), dict) else {}
    except (OSError, json.JSONDecodeError):
        pass
    if "barCare" not in store:
        store["barCare"] = normalize_bar_care(None)
    if "scaleKeys" not in store:
        store["scaleKeys"] = {}
    return store


def _clamp_int(value, lo, hi, fallback):
    try:
        n = int(round(float(value)))
    except (TypeError, ValueError):
        return fallback
    if n < lo:
        return lo
    if n > hi:
        return hi
    return n


def normalize_bar_care(raw):
    src = raw if isinstance(raw, dict) else {}
    hover = src.get("hoverLift")
    return {
        "enabled": bool(src.get("enabled")),
        "dim": _clamp_int(src.get("dim"), 0, 100, 45),
        "hoverLift": True if hover is None else bool(hover),
    }


def set_bar_care(key, value):
    store = load_store()
    care = normalize_bar_care(store.get("barCare"))
    name = str(key or "").strip().lower().replace("_", "-")
    if name in ("enabled", "on"):
        care["enabled"] = str(value).strip().lower() in ("1", "true", "on", "yes")
    elif name == "dim":
        care["dim"] = _clamp_int(value, 0, 100, care["dim"])
    elif name in ("hover", "hover-lift", "hoverlift"):
        care["hoverLift"] = str(value).strip().lower() in ("1", "true", "on", "yes")
    else:
        print("bar-care: enabled|dim|hover", file=sys.stderr)
        return 2
    store["barCare"] = care
    save_store(store)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def merge_desk_layout(prev, entries):
    """Keep unplugged desk members so a replug can restore them."""
    current = [e for e in (entries or []) if isinstance(e, dict) and e.get("id")]
    previous = [e for e in (prev or []) if isinstance(e, dict) and e.get("id")]
    if not previous:
        return current
    current_ids = {e["id"] for e in current}
    previous_ids = {e["id"] for e in previous}
    if current_ids and current_ids < previous_ids:
        kept = [e for e in previous if e["id"] not in current_ids]
        return current + kept
    return current


def remember_layout(monitors):
    store = load_store()
    entries = [profile_entry_from_monitor(m) for m in monitors if monitor_identity(m)]
    store["lastLayout"] = entries
    if not any((e.get("mirror") or "") for e in entries):
        store["deskLayout"] = merge_desk_layout(store.get("deskLayout"), entries)
    save_store(store)


def refresh_active_profile(monitors):
    store = load_store()
    name = store.get("active") or ""
    if not name:
        return
    entries = [profile_entry_from_monitor(m) for m in monitors if monitor_identity(m)]
    if not entries:
        return
    others = [p for p in store.get("profiles") or [] if p.get("name") != name]
    store["profiles"] = others + [{"name": name, "monitors": entries}]
    save_store(store)


def layout_map(entries):
    out = {}
    for entry in entries or []:
        if isinstance(entry, dict) and entry.get("id"):
            out[entry["id"]] = entry
    return out


def restore_desk_geometry(monitors):
    store = load_store()
    hints = layout_map(store.get("deskLayout"))
    if not hints:
        profile = find_profile(store, store.get("active") or "")
        if profile:
            hints = layout_map(profile.get("monitors"))
    if not hints:
        return monitors
    for mon in monitors:
        rule = hints.get(mon.get("identity") or "")
        if not rule:
            continue
        for key in (
            "mode", "x", "y", "scale", "transform", "vrr", "hdr",
            "hdrMode", "bitdepth", "cm", "sdrMinLuminance", "sdrMaxLuminance",
            "sdrBrightness", "sdrSaturation", "sdrEotf", "supportsWideColor",
            "textPx", "minLuminance",
            "maxLuminance", "maxAvgLuminance",
        ):
            if key in rule:
                mon[key] = rule[key]
        mon["mirror"] = ""
        mon["logicalW"], mon["logicalH"] = logical_size(
            mon.get("width"),
            mon.get("height"),
            mon.get("scale"),
            mon.get("transform"),
        )
    return monitors


def drm_outputs():
    out = []
    for path in sorted(glob.glob("/sys/class/drm/card*-*/status")):
        try:
            status = open(path, encoding="utf-8").read().strip()
        except OSError:
            continue
        if status != "connected":
            continue
        base = os.path.basename(os.path.dirname(path))
        m = re.match(r"card(\d+)-(.+)$", base)
        if not m or m.group(2).startswith("Writeback"):
            continue
        card = int(m.group(1))
        driver = ""
        try:
            driver = os.path.basename(os.path.realpath("/sys/class/drm/card%d/device/driver" % card))
        except OSError:
            pass
        out.append({"name": m.group(2), "card": card, "driver": driver})
    return out


def hybrid_gpus(entries=None):
    entries = drm_outputs() if entries is None else entries
    return len({e["card"] for e in entries}) > 1


def primary_drivers(entries=None):
    entries = drm_outputs() if entries is None else entries
    drivers = {e["driver"] for e in entries if e.get("driver")}
    if "nvidia" in drivers:
        return {"nvidia"}
    boot = None
    for card in {e["card"] for e in entries}:
        try:
            flag = open("/sys/class/drm/card%d/device/boot_vga" % card, encoding="utf-8").read().strip()
        except OSError:
            continue
        if flag == "1":
            boot = card
            break
    if boot is not None:
        return {e["driver"] for e in entries if e["card"] == boot and e.get("driver")}
    return drivers


def hypr_dpms(action, monitor=None):
    if monitor:
        expr = 'hl.dsp.dpms({ action = %s, monitor = %s })' % (lua_str(action), lua_str(monitor))
    else:
        expr = 'hl.dsp.dpms({ action = %s })' % lua_str(action)
    run(["hyprctl", "eval", "hl.dispatch(%s)" % expr])


def screens_blank(name):
    run(["omarchy-shell", "-q", "im0001gt.screens", "blank", name])


def screens_unblank():
    run(["omarchy-shell", "-q", "im0001gt.screens", "unblank"])


def packaged_brightness():
    path = "/usr/share/omarchy/bin/omarchy-brightness-display"
    return path if os.path.isfile(path) and os.access(path, os.X_OK) else ""


def idle_off():
    entries = drm_outputs()
    if not hybrid_gpus(entries):
        real = packaged_brightness()
        if real:
            run([real, "off"])
        else:
            hypr_dpms("disable")
        return 0
    # Primary = Aquamarine's render GPU (NVIDIA when present, else boot_vga).
    # Any output on another GPU is blanked instead of Hyprland-DPMS'd.
    primary = primary_drivers(entries)
    live = hypr_json(["monitors"]) or []
    names = [m.get("name") for m in live if m.get("name") and not m.get("disabled")]
    by_name = {e["name"]: e for e in entries}
    for name in names:
        info = by_name.get(name) or {}
        if info.get("driver") in primary:
            hypr_dpms("disable", name)
        else:
            screens_blank(name)
    return 0


def idle_on():
    screens_unblank()
    real = packaged_brightness()
    if real:
        run([real, "on"])
    else:
        hypr_dpms("enable")
    return 0


def notice_seen():
    store = load_store()
    store["hybridNoticeShown"] = True
    save_store(store)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def save_store(store):
    write_private_file(PROFILES_PATH, json.dumps(store, indent=2) + "\n")


def find_profile(store, name):
    for profile in store.get("profiles") or []:
        if profile.get("name") == name:
            return profile
    return None


def match_profile(store, identities):
    ids = set(identities)
    if not ids:
        return ""
    exact = ""
    best = ""
    best_score = 0
    for profile in store.get("profiles") or []:
        pids = {m.get("id") for m in profile.get("monitors") or [] if m.get("id")}
        if not pids:
            continue
        if pids == ids:
            exact = profile.get("name") or ""
        elif pids <= ids and len(pids) > best_score:
            best = profile.get("name") or ""
            best_score = len(pids)
    return exact or best


def profile_rule(profile, identity):
    for mon in profile.get("monitors") or []:
        if mon.get("id") == identity:
            return mon
    return None


MODE_RE = re.compile(
    r"^(preferred|highres|highrr|maxwidth|\d{3,5}x\d{3,5}(@\d{1,4}(\.\d{1,3})?)?)$"
)
PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 .,_+-]{0,47}$")
CONNECTOR_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")


def clean_profile_name(name):
    text = " ".join(str(name or "").split())
    if not PROFILE_NAME_RE.match(text):
        return ""
    return text


def clean_mode(mode):
    text = str(mode or "preferred").strip()
    return text if MODE_RE.match(text) else "preferred"


def clean_int(value, lo, hi, default=0):
    try:
        n = int(round(float(value)))
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


def clean_scale(value):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return 1
    if n <= 0 or n > 8:
        return 1
    return round(n, 3)


def clean_float(value, lo, hi, default):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return default
    if n < lo or n > hi:
        return default
    return n


def clean_bitdepth(value, default=10):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return 10 if n >= 10 else 8


def hypr_wire_bitdepth(value):
    return 10 if clean_bitdepth(value, 10) >= 10 else 8


def clean_wide_color(value):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return 0
    if n > 0:
        return 1
    if n < 0:
        return -1
    return 0


def clean_cm(value):
    text = str(value or "").strip().lower()
    return text if text in CM_PRESETS else "srgb"


def clean_sdr_eotf(value):
    text = str(value or "").strip().lower()
    return text if text in ("default", "srgb", "gamma22") else "default"


def clean_workspace_layout(value):
    text = str(value or "").strip().lower()
    if text in ("tile", "tiling", "tiled", "dwindle"):
        return "tile"
    if text in ("scroll", "scrolling"):
        return "scroll"
    if text in ("float", "floating"):
        return "float"
    return ""


def hdr_mode(mon):
    raw = mon.get("hdrMode")
    if raw is not None and raw != "":
        try:
            n = int(raw)
        except (TypeError, ValueError):
            n = -1
        if n in (0, 1, 2):
            return n
    return 2 if mon.get("hdr") else 0


def auto_hdr_render(monitors):
    autos = [m for m in monitors if m.get("enabled", True) and hdr_mode(m) == 1]
    if not autos:
        return 0
    if any(clean_cm(m.get("cm")) == "hdredid" or not m.get("wideGamut") for m in autos):
        return 2
    return 1


def format_float(n):
    text = ("%.4f" % float(n)).rstrip("0").rstrip(".")
    return text if text else "0"


def clean_connector(name):
    text = str(name or "").strip()
    return text if CONNECTOR_RE.match(text) else ""


def sanitize_monitor(mon, known_names=None):
    known_names = known_names or set()
    name = clean_connector(mon.get("name"))
    desc = " ".join(str(mon.get("description") or "").split())
    if "\n" in desc or "\r" in desc:
        desc = ""
    mirror = clean_connector(mon.get("mirror"))
    if mirror and mirror == name:
        mirror = ""
    if mirror and known_names and mirror not in known_names:
        mirror = ""
    mode = hdr_mode(mon)
    cm = clean_cm(mon.get("cm"))
    if mode == 0 and cm in ("hdr", "hdredid"):
        cm = "srgb"
    return {
        "name": name,
        "description": desc,
        "mode": clean_mode(mon.get("mode")),
        "x": clean_int(mon.get("x"), -32768, 32767, 0),
        "y": clean_int(mon.get("y"), -32768, 32767, 0),
        "scale": clean_scale(mon.get("scale")),
        "transform": clean_int(mon.get("transform"), 0, 7, 0),
        "vrr": clean_int(mon.get("vrr"), 0, 3, 0),
        "hdr": mode == 2,
        "hdrMode": mode,
        "bitdepth": clean_bitdepth(mon.get("bitdepth"), 10),
        "cm": cm,
        "sdrMinLuminance": clean_float(mon.get("sdrMinLuminance"), 0.0, 1.0, 0.005),
        "sdrMaxLuminance": clean_int(mon.get("sdrMaxLuminance"), 40, 1000, 200),
        "sdrBrightness": clean_float(mon.get("sdrBrightness"), 0.5, 2.5, 1.0),
        "sdrSaturation": clean_float(mon.get("sdrSaturation"), 0.5, 2.0, 1.0),
        "sdrEotf": clean_sdr_eotf(mon.get("sdrEotf")),
        "supportsWideColor": clean_wide_color(mon.get("supportsWideColor")),
        "minLuminance": clean_float(mon.get("minLuminance"), 0.0, 10.0, -1),
        "maxLuminance": clean_int(mon.get("maxLuminance"), -1, 10000, -1),
        "maxAvgLuminance": clean_int(mon.get("maxAvgLuminance"), -1, 10000, -1),
        "textPx": clean_int(mon.get("textPx"), 0, 20, 0),
        "enabled": bool(mon.get("enabled", True)),
        "identity": mon.get("identity") or "",
        "mirror": mirror,
    }


INTERNAL_PANEL_RE = re.compile(r"^(eDP|LVDS|DSI)", re.I)


def is_internal_panel(mon):
    name = mon.get("name") if isinstance(mon, dict) else mon
    return bool(INTERNAL_PANEL_RE.match(str(name or "")))


def should_recover_internal(drm_names=None):
    names = list(drm_names) if drm_names is not None else drm_connected_names()
    has_internal = any(is_internal_panel(n) for n in names)
    has_external = any(not is_internal_panel(n) for n in names)
    return bool(has_internal and not has_external)


def enable_drm_internals(monitors, drm_names):
    """Put every DRM-connected laptop panel in the list and turn it on."""
    monitors = list(monitors or [])
    changed = False
    have = {m.get("name") for m in monitors}
    for name in drm_names or []:
        if not is_internal_panel(name):
            continue
        if name not in have:
            stub = stub_monitor(name)
            stub["enabled"] = True
            monitors.append(stub)
            have.add(name)
            changed = True
            continue
        for mon in monitors:
            if mon.get("name") == name and not mon.get("enabled", True):
                mon["enabled"] = True
                changed = True
    return monitors, changed


def recover_last_internal(monitors, drm_names=None):
    """If nothing enabled remains, turn the laptop panel back on."""
    names = drm_names
    if names is None:
        names = [m.get("name") for m in (monitors or []) if m.get("name")]
    if not should_recover_internal(names):
        return False
    _, changed = enable_drm_internals(monitors, names)
    return changed


def default_sdr_max(mon):
    for key in ("maxAvgLuminance", "maxLuminance"):
        try:
            n = int(float(mon.get(key)))
        except (TypeError, ValueError):
            continue
        if n >= 80:
            return min(n, 1000)
    try:
        n = int(float(mon.get("sdrMaxLuminance")))
        if 40 <= n <= 1000:
            return n
    except (TypeError, ValueError):
        pass
    return 203


def sdr_max_for_write(mon):
    peak = default_sdr_max(mon)
    try:
        n = int(float(mon.get("sdrMaxLuminance")))
    except (TypeError, ValueError):
        return peak
    if n <= 80:
        return peak
    if n == 200 and peak >= 400:
        return peak
    return clean_int(n, 40, 1000, peak)


def internal_toggle_active():
    return os.path.isfile(INTERNAL_TOGGLE)


def set_internal_toggle(disabled, mon=None):
    if not disabled:
        if os.path.isfile(INTERNAL_TOGGLE):
            try:
                os.unlink(INTERNAL_TOGGLE)
            except OSError:
                pass
        return
    name = clean_connector((mon or {}).get("name"))
    if not is_internal_panel(name):
        return
    os.makedirs(os.path.dirname(INTERNAL_TOGGLE), exist_ok=True)
    write_private_file(
        INTERNAL_TOGGLE,
        "hl.monitor({ output = %s, disabled = true })\n" % lua_str(name),
    )


def sync_internal_overlay(monitors):
    internals = [m for m in (monitors or []) if is_internal_panel(m)]
    if not internals:
        return
    want_off = any(not m.get("enabled", True) for m in internals)
    set_internal_toggle(want_off, internals[0])


def monitors_lua_needs_rewrite(text):
    blob = text or ""
    if re.search(r'output\s*=\s*"(?:eDP|LVDS|DSI)[^"]*"\s*,\s*disabled\s*=\s*true', blob, re.I):
        return True
    if "sdr_max_luminance" in blob and "supports_hdr" in blob:
        if 'cm = "hdr"' not in blob and 'cm = "hdredid"' not in blob:
            return True
    return False


def recover_internal(quiet=False):
    drm_names = drm_connected_names()
    if not should_recover_internal(drm_names):
        return 0
    toggle_was_on = internal_toggle_active()
    set_internal_toggle(False)
    data = snapshot()
    monitors = data.get("monitors") or []
    monitors, changed = enable_drm_internals(monitors, drm_names)
    if not monitors:
        return 0
    already_on = any(
        is_internal_panel(m) and m.get("enabled", True) for m in monitors
    )
    # The clamshell watcher and Screens both retry this. Reloading Hyprland
    # eight times after the laptop is already up leaves USB-C DP dongles in
    # USB-only alt-mode, so the external never comes back on replug.
    if already_on and not changed and not toggle_was_on:
        if not quiet:
            print(json.dumps(data, separators=(",", ":")))
        return 0
    write_monitors_lua(monitors)
    reload_hypr()
    for name in drm_names:
        if not is_internal_panel(name):
            continue
        run([
            "hyprctl",
            "eval",
            "hl.monitor({ output = %s, mode = \"preferred\", position = \"auto\", scale = \"auto\" })"
            % lua_str(name),
        ])
    run(["hyprctl", "dispatch", 'hl.dsp.dpms({ action = "enable" })'])
    run(["omarchy-hyprland-monitor-internal", "recover"])
    remember_layout(monitors)
    if not quiet:
        print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def output_ref(mon, used_desc):
    name = clean_connector(mon.get("name"))
    # omarchy-hyprland-monitor-clamshell only reads the internal panel's rule
    # when it is keyed by connector name. Behind a desc: key it finds no scale,
    # falls back to 2, and re-applies it every 2s while docked.
    if name and INTERNAL_PANEL_RE.match(name):
        return name
    desc = clean_desc(mon.get("description") or "")
    if desc and desc not in used_desc:
        used_desc.add(desc)
        return "desc:%s" % desc
    return name or "Unknown"


def monitor_lua(mon, used_desc):
    name = output_ref(mon, used_desc)
    # Named `disabled = true` for the laptop panel beats the catch-all fallback
    # after the last external is unplugged. Omarchy's overlay toggle is what
    # actually turns the internal panel off; recover can then lift it.
    if not mon.get("enabled", True) and not is_internal_panel(mon):
        return "hl.monitor({ output = %s, disabled = true })" % lua_str(name)
    fields = [
        "output = %s" % lua_str(name),
        "mode = %s" % lua_str(mon.get("mode") or "preferred"),
        "position = %s" % lua_str("%dx%d" % (int(mon.get("x") or 0), int(mon.get("y") or 0))),
        "scale = %s" % (mon.get("scale") if mon.get("scale") not in (None, "") else 1),
    ]
    transform = int(mon.get("transform") or 0)
    if transform:
        fields.append("transform = %d" % transform)
    # Persist the integer even when 0. hyprctl often reports VRR as a boolean.
    fields.append("vrr = %d" % int(mon.get("vrr") or 0))
    mode = hdr_mode(mon)
    cm = clean_cm(mon.get("cm"))
    if mode == 0 and cm in ("hdr", "hdredid"):
        cm = "srgb"
    if mode == 1:
        fields.append("bitdepth = %d" % hypr_wire_bitdepth(mon.get("bitdepth")))
        fields.append("supports_hdr = 1")
    elif mode == 2:
        fields.append("bitdepth = %d" % hypr_wire_bitdepth(mon.get("bitdepth")))
        fields.append("supports_hdr = 1")
        if cm not in ("hdr", "hdredid"):
            cm = "hdredid"
        fields.append("cm = %s" % lua_str(cm))
        sdr_min = mon.get("sdrMinLuminance")
        if sdr_min is None:
            sdr_min = 0.005
        fields.append("sdr_min_luminance = %s" % format_float(sdr_min))
        fields.append("sdr_max_luminance = %d" % sdr_max_for_write(mon))
        sdr_bright = mon.get("sdrBrightness")
        if sdr_bright is None:
            sdr_bright = 1.0
        fields.append("sdrbrightness = %s" % format_float(sdr_bright))
        sdr_sat = mon.get("sdrSaturation")
        if sdr_sat is None:
            sdr_sat = 1.0
        if abs(float(sdr_sat) - 1.0) > 0.001:
            fields.append("sdrsaturation = %s" % format_float(sdr_sat))
        eotf = clean_sdr_eotf(mon.get("sdrEotf"))
        if eotf != "default":
            fields.append("sdr_eotf = %s" % lua_str(eotf))
        min_lum = mon.get("minLuminance")
        try:
            min_lum = float(min_lum)
        except (TypeError, ValueError):
            min_lum = -1
        if min_lum >= 0:
            fields.append("min_luminance = %s" % format_float(min_lum))
        max_lum = clean_int(mon.get("maxLuminance"), -1, 10000, -1)
        if max_lum > 0:
            fields.append("max_luminance = %d" % max_lum)
        max_avg = clean_int(mon.get("maxAvgLuminance"), -1, 10000, -1)
        if max_avg > 0:
            fields.append("max_avg_luminance = %d" % max_avg)
        wide = clean_wide_color(mon.get("supportsWideColor"))
        if wide:
            fields.append("supports_wide_color = %d" % wide)
    elif cm and cm not in ("srgb", "hdr", "hdredid"):
        fields.append("cm = %s" % lua_str(cm))
        wide = clean_wide_color(mon.get("supportsWideColor"))
        if wide:
            fields.append("supports_wide_color = %d" % wide)
    mirror = mon.get("mirror") or ""
    if mirror and mirror not in ("none", name, mon.get("name")):
        fields.append("mirror = %s" % lua_str(mirror))
    return "hl.monitor({ %s })" % ", ".join(fields)


def split_counts(n, total=WORKSPACE_COUNT):
    """Spread `total` workspaces across `n` monitors. Extra slots go to the first."""
    try:
        n = int(n)
    except (TypeError, ValueError):
        n = 0
    if n <= 0:
        return []
    if n >= total:
        return [1] * total + [0] * (n - total)
    base = total // n
    extra = total % n
    return [base + 1] * extra + [base] * (n - extra)


def workspace_hosts(monitors, primary=""):
    hosts = []
    for mon in monitors or []:
        if not mon.get("enabled", True):
            continue
        if mon.get("mirror"):
            continue
        hosts.append(mon)

    def sort_key(mon):
        ident = mon.get("identity") or monitor_identity(mon)
        lead = 0 if (primary and ident == primary) else 1
        return (lead, int(mon.get("x") or 0), int(mon.get("y") or 0), mon.get("name") or "")

    hosts.sort(key=sort_key)
    return hosts


def workspace_plan(monitors, primary=""):
    hosts = workspace_hosts(monitors, primary)
    counts = split_counts(len(hosts))
    n = 1
    plan = []
    for mon, count in zip(hosts, counts):
        ids = list(range(n, n + count)) if count else []
        n += count
        plan.append({
            "name": mon.get("name") or "",
            "identity": mon.get("identity") or monitor_identity(mon),
            "label": mon.get("label") or mon.get("name") or "",
            "ids": ids,
            "first": ids[0] if ids else 0,
            "last": ids[-1] if ids else 0,
        })
    return plan


def saved_plan():
    data = read_workspaces_json()
    plan = data.get("monitors")
    if isinstance(plan, list) and plan:
        return plan
    return None


def plan_for_write(monitors):
    """Keep a saved custom assignment, remapped onto the live hosts."""
    saved = saved_plan()
    primary = load_store().get("primary") or ""
    auto = workspace_plan(monitors, primary)
    if not saved:
        return auto
    by_id = {}
    by_name = {}
    for item in saved:
        ident = item.get("identity") or ""
        if ident:
            by_id[ident] = item
        name = clean_connector(item.get("name"))
        if name:
            by_name[name] = item
    plan = []
    used = set()
    for host in workspace_hosts(monitors, primary):
        ident = host.get("identity") or monitor_identity(host)
        name = clean_connector(host.get("name"))
        item = by_id.get(ident) or by_name.get(name)
        ids = []
        for ws in (item.get("ids") if item else []) or []:
            try:
                ws = int(ws)
            except (TypeError, ValueError):
                continue
            if ws < 1 or ws > WORKSPACE_COUNT or ws in used:
                continue
            used.add(ws)
            ids.append(ws)
        ids.sort()
        plan.append({
            "name": host.get("name") or "",
            "identity": ident,
            "label": host.get("label") or host.get("name") or "",
            "ids": ids,
            "first": ids[0] if ids else 0,
            "last": ids[-1] if ids else 0,
        })
    return plan


def normalize_plan(monitors, raw):
    known = {}
    for mon in monitors or []:
        ident = mon.get("identity") or monitor_identity(mon)
        known.setdefault(clean_connector(mon.get("name") or ""), mon)
        if ident:
            known.setdefault(ident, mon)
    plan = []
    used = set()
    errors = []
    for item in raw or []:
        if not isinstance(item, dict):
            errors.append("plan item must be an object: %r" % (item,))
            continue
        ref = str(item.get("name") or item.get("identity") or "").strip()
        mon = known.get(ref) or known.get(clean_connector(ref))
        if ref and not mon:
            errors.append("no such display: %s" % ref)
            continue
        if not mon:
            errors.append("plan item missing a display name or identity")
            continue
        ids = []
        for ws in item.get("ids") or []:
            try:
                ws = int(ws)
            except (TypeError, ValueError):
                errors.append("workspace must be a number: %r" % (ws,))
                continue
            if ws < 1 or ws > WORKSPACE_COUNT:
                errors.append("workspace %d out of range 1-%d" % (ws, WORKSPACE_COUNT))
                continue
            if ws in used:
                errors.append("workspace %d assigned to more than one screen" % ws)
                continue
            used.add(ws)
            ids.append(ws)
        ids.sort()
        plan.append({
            "name": mon.get("name") or "",
            "identity": mon.get("identity") or monitor_identity(mon),
            "label": mon.get("label") or mon.get("name") or "",
            "ids": ids,
            "first": ids[0] if ids else 0,
            "last": ids[-1] if ids else 0,
        })
    return plan, errors


def assign_workspaces(raw):
    monitors = snapshot()["monitors"]
    plan, errors = normalize_plan(monitors, raw)
    if errors:
        for err in errors:
            print("workspaces assign: %s" % err, file=sys.stderr)
        return 2
    store = load_store()
    write_workspaces_json(True, plan, store.get("workspaceLayouts") or {})
    write_monitors_lua(snapshot_monitors_for_write())
    reload_hypr()
    pin_workspaces(plan)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def auto_workspaces():
    store = load_store()
    monitors = snapshot()["monitors"]
    plan = workspace_plan(monitors, store.get("primary") or "")
    write_workspaces_json(True, plan, store.get("workspaceLayouts") or {})
    write_monitors_lua(snapshot_monitors_for_write())
    reload_hypr()
    pin_workspaces(plan)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def report_workspace_plan():
    data = read_workspaces_json()
    print(json.dumps({
        "enabled": bool(data.get("enabled")),
        "total": data.get("total", WORKSPACE_COUNT),
        "monitors": data.get("monitors") or [],
        "layouts": data.get("layouts") or {},
        "labels": data.get("labels") or {},
    }, separators=(",", ":")))
    return 0


def workspace_rule_lines(monitors, primary=""):
    plan = plan_for_write(monitors)
    used = set()
    refs = {}
    for mon in monitors or []:
        if mon.get("name") or mon.get("description"):
            refs[mon.get("name") or ""] = output_ref(mon, used)
    lines = []
    for item in plan:
        output = refs.get(item.get("name") or "")
        if not output or not item.get("ids"):
            continue
        for i, ws in enumerate(item["ids"]):
            fields = [
                'workspace = "%d"' % ws,
                "monitor = %s" % lua_str(output),
                "persistent = true",
            ]
            if i == 0:
                fields.append("default = true")
            lines.append("hl.workspace_rule({ %s })" % ", ".join(fields))
    return lines


def managed_block_lines(monitors):
    used = set()
    inner = [MANAGED_BEGIN]
    for mon in monitors:
        if mon.get("name") or mon.get("description"):
            inner.append(monitor_lua(mon, used))
    inner.append('hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })')
    max_vrr = 0
    for mon in monitors:
        if mon.get("enabled", True):
            max_vrr = max(max_vrr, int(mon.get("vrr") or 0))
    inner.append(
        "hl.config({ misc = { vrr = %d }, render = { cm_auto_hdr = %d } })"
        % (max_vrr, auto_hdr_render(monitors))
    )
    store = load_store()
    if store.get("manageWorkspaces"):
        inner.extend(workspace_rule_lines(monitors, store.get("primary") or ""))
    inner.append(MANAGED_END)
    return inner


def render_lua(monitors, gdk_scale):
    lines = [
        "-- See https://wiki.hypr.land/Configuring/Basics/Monitors/",
        "-- Managed by im0001gt.screens (Screens bar panel).",
        "",
        "local omarchy_gdk_scale = %s" % gdk_scale,
        'hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))',
        "",
    ]
    lines.extend(managed_block_lines(monitors))
    lines.append("")
    return "\n".join(lines) + "\n"


def looks_managed(text):
    return MANAGED_BEGIN in (text or "")


def read_text(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def originals_dir():
    return os.path.join(BACKUP_DIR, "originals")


def originals_manifest_path():
    return os.path.join(originals_dir(), "manifest.json")


def restore_helper_path():
    return os.path.join(BACKUP_DIR, "restore.sh")


def is_owned_real_dir(path):
    if not path or os.path.islink(path) or not os.path.isdir(path):
        return False
    try:
        return os.lstat(path).st_uid == os.getuid()
    except OSError:
        return False


def _nofollow_flag():
    return getattr(os, "O_NOFOLLOW", 0)


def _dir_flags():
    return os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | _nofollow_flag()


def trusted_root_for(path):
    path = os.path.abspath(path)
    home = os.path.abspath(os.path.expanduser("~"))
    try:
        if os.path.commonpath([path, home]) == home and is_owned_real_dir(home):
            return home
    except ValueError:
        pass
    cur = path
    found = None
    while True:
        if is_owned_real_dir(cur):
            found = cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    if not found:
        raise OSError("no owned ancestor for %s" % path)
    return found


def ensure_owned_dir(path):
    path = os.path.abspath(path)
    root = trusted_root_for(path)
    rel = os.path.relpath(path, root)
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if st.st_uid != os.getuid() or not stat.S_ISDIR(st.st_mode):
            raise OSError("untrusted root directory")
        if rel == ".":
            os.fchmod(fd, 0o700)
            return
        for part in rel.split(os.sep):
            if part in ("", ".", ".."):
                raise OSError("invalid path component")
            try:
                nxt = os.open(part, _dir_flags(), dir_fd=fd)
            except FileNotFoundError:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                nxt = os.open(part, _dir_flags(), dir_fd=fd)
            os.close(fd)
            fd = nxt
            st = os.fstat(fd)
            if st.st_uid != os.getuid() or not stat.S_ISDIR(st.st_mode):
                raise OSError("untrusted ancestor %s" % part)
            os.fchmod(fd, 0o700)
    finally:
        os.close(fd)


def open_owned_dirfd(path):
    path = os.path.abspath(path)
    ensure_owned_dir(path)
    fd = os.open(path, _dir_flags())
    try:
        st = os.fstat(fd)
        if st.st_uid != os.getuid() or not stat.S_ISDIR(st.st_mode):
            raise OSError("untrusted directory")
    except Exception:
        os.close(fd)
        raise
    return fd


def ensure_private_dir(path):
    ensure_owned_dir(path)


def write_private_file(path, data, mode=0o600):
    if not isinstance(data, (bytes, bytearray)):
        data = str(data).encode("utf-8")
    path = os.path.abspath(path)
    directory = os.path.dirname(path)
    name = os.path.basename(path)
    if not name or name in (".", "..") or os.sep in name:
        raise OSError("invalid destination")
    dir_fd = open_owned_dirfd(directory)
    tmp_name = None
    fd = None
    try:
        flags = os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | _nofollow_flag()
        for _ in range(32):
            candidate = ".screens-%s" % os.urandom(8).hex()
            try:
                fd = os.open(candidate, flags, 0o600, dir_fd=dir_fd)
                tmp_name = candidate
                break
            except FileExistsError:
                continue
        if fd is None:
            raise OSError("could not create exclusive staging file")
        st = os.fstat(fd)
        if st.st_uid != os.getuid() or not stat.S_ISREG(st.st_mode):
            raise OSError("staging file untrusted")
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("short write")
            view = view[written:]
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        tmp_name = None
    finally:
        if fd is not None:
            os.close(fd)
        if tmp_name:
            try:
                os.unlink(tmp_name, dir_fd=dir_fd)
            except OSError:
                pass
        os.close(dir_fd)
    return True


def write_original_backup(text):
    write_private_file(ORIGINAL_BACKUP, text)
    write_private_file(os.path.join(originals_dir(), "monitors.lua"), text)
    return True


def strip_managed_block(text):
    text = text or ""
    if MANAGED_BEGIN not in text:
        return text
    pre = text.split(MANAGED_BEGIN, 1)[0]
    post = text.split(MANAGED_END, 1)[1] if MANAGED_END in text else ""
    return (pre.rstrip() + ("\n" + post.lstrip("\n") if post.strip() else "\n")).lstrip("\n")


def leftover_outside_managed(text):
    """True if monitors.lua still has monitor rules outside the Screens block."""
    leftover = strip_managed_block(text or "")
    if re.search(r"hyprmoncfg", leftover, re.I):
        return True
    if re.search(r"omarchy_monitor_scale", leftover):
        return True
    if re.search(r"hl\.monitor\s*\(", leftover):
        return True
    if re.search(r"^\s*monitor\s*=", leftover, re.M):
        return True
    return bool((text or "").strip()) and not looks_managed(text)


def load_originals_manifest():
    data = {
        "version": 1,
        "files": {},
        "workspaceLayouts": {},
        "brightnessLink": {},
    }
    try:
        with open(originals_manifest_path(), encoding="utf-8") as fh:
            raw = json.load(fh)
        if isinstance(raw, dict):
            data["files"] = raw.get("files") if isinstance(raw.get("files"), dict) else {}
            data["workspaceLayouts"] = (
                raw.get("workspaceLayouts") if isinstance(raw.get("workspaceLayouts"), dict) else {}
            )
            data["brightnessLink"] = (
                raw.get("brightnessLink") if isinstance(raw.get("brightnessLink"), dict) else {}
            )
    except (OSError, json.JSONDecodeError):
        pass
    return data


def save_originals_manifest(data):
    write_private_file(originals_manifest_path(), json.dumps(data, indent=2) + "\n")


def capture_text_original(key, dest_name, text, present):
    manifest = load_originals_manifest()
    files = manifest.setdefault("files", {})
    if key in files:
        return False
    dest = os.path.join(originals_dir(), dest_name)
    if present and (text or "").strip():
        write_private_file(dest, text)
    files[key] = {"present": bool(present and (text or "").strip()), "name": dest_name}
    save_originals_manifest(manifest)
    return True


def monitors_original_text(text=None):
    if os.path.isfile(ORIGINAL_BACKUP):
        return read_text(ORIGINAL_BACKUP)
    nested = os.path.join(originals_dir(), "monitors.lua")
    if os.path.isfile(nested):
        return read_text(nested)
    if text is None:
        text = read_text(MONITORS_LUA) if os.path.isfile(MONITORS_LUA) else ""
    if text.strip() and not looks_managed(text):
        return text
    for path in sorted(glob.glob(os.path.join(BACKUP_DIR, STAMPED_BACKUP_GLOB))):
        body = read_text(path)
        if body.strip() and not looks_managed(body):
            return body
    return text or ""


def capture_monitors_original(text=None):
    if os.path.isfile(ORIGINAL_BACKUP) or os.path.isfile(os.path.join(originals_dir(), "monitors.lua")):
        if os.path.isfile(ORIGINAL_BACKUP) and not os.path.isfile(os.path.join(originals_dir(), "monitors.lua")):
            write_private_file(os.path.join(originals_dir(), "monitors.lua"), read_text(ORIGINAL_BACKUP))
        manifest = load_originals_manifest()
        if "monitors.lua" not in manifest.get("files", {}):
            manifest.setdefault("files", {})["monitors.lua"] = {"present": True, "name": "monitors.lua"}
            save_originals_manifest(manifest)
        return False
    body = monitors_original_text(text)
    if not (body or "").strip():
        capture_text_original("monitors.lua", "monitors.lua", "", False)
        return False
    write_original_backup(body)
    manifest = load_originals_manifest()
    manifest.setdefault("files", {})["monitors.lua"] = {"present": True, "name": "monitors.lua"}
    save_originals_manifest(manifest)
    return True


def capture_bindings_original():
    dest = os.path.join(originals_dir(), "bindings.lua")
    if os.path.isfile(dest):
        return False
    present = os.path.isfile(BINDINGS_LUA)
    text = read_text(BINDINGS_LUA) if present else ""
    if looks_managed(text):
        text = strip_managed_block(text)
    return capture_text_original("bindings.lua", "bindings.lua", text, present)


def reconstructed_shell_original():
    config = load_shell_json()
    if not config:
        return "", False
    section, index, eid, entry = find_workspaces_slot(config)
    store = load_store()
    if eid == OUR_WS_WIDGET:
        old_id = store.get("workspacesBarId") or STOCK_WS_WIDGET
        if isinstance(entry, str):
            config["bar"]["layout"][section][index] = old_id
        elif isinstance(entry, dict):
            next_entry = dict(entry)
            next_entry["id"] = old_id
            config["bar"]["layout"][section][index] = next_entry
    return json.dumps(config, indent=2) + "\n", True


def capture_shell_original():
    dest = os.path.join(originals_dir(), "shell.json")
    if os.path.isfile(dest):
        return False
    if not os.path.isfile(SHELL_JSON):
        return capture_text_original("shell.json", "shell.json", "", False)
    text = read_text(SHELL_JSON)
    if OUR_WS_WIDGET in text:
        reconstructed, present = reconstructed_shell_original()
        if present:
            text = reconstructed
    return capture_text_original("shell.json", "shell.json", text, True)


def capture_workspace_layouts():
    manifest = load_originals_manifest()
    layouts = manifest.setdefault("workspaceLayouts", {})
    changed = False
    layout_dir = os.path.join(originals_dir(), "workspace-layouts")
    for i in range(1, WORKSPACE_COUNT + 1):
        key = str(i)
        if key in layouts:
            continue
        src = os.path.join(LAYOUTS_DIR, "%d.lua" % i)
        if os.path.isfile(src):
            write_private_file(os.path.join(layout_dir, "%d.lua" % i), read_text(src))
            layouts[key] = "present"
        else:
            layouts[key] = "absent"
        changed = True
    if changed:
        save_originals_manifest(manifest)
    return changed


def capture_brightness_link():
    manifest = load_originals_manifest()
    if manifest.get("brightnessLink"):
        return False
    path = BRIGHTNESS_LINK
    info = {"path": path, "state": "absent", "previous": ""}
    if os.path.islink(path):
        previous = os.readlink(path)
        if "im0001gt.screens" in previous:
            info["state"] = "absent"
            info["previous"] = ""
        else:
            info["state"] = "replaced"
            info["previous"] = previous
    elif os.path.exists(path):
        info["state"] = "replaced"
        info["previous"] = ""
    else:
        info["state"] = "absent"
    manifest["brightnessLink"] = info
    save_originals_manifest(manifest)
    return True


def write_restore_helper():
    script = """#!/bin/bash
# First-install restore for Screens. Lives outside the plugin so it still
# works after: omarchy plugin remove im0001gt.screens
set -euo pipefail
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/im0001gt.screens"
ORIG="$STATE/originals"
MANIFEST="$ORIG/manifest.json"
if [[ ! -f $MANIFEST ]]; then
  echo "restore: no first-install snapshot at $ORIG" >&2
  exit 2
fi
python3 - "$ORIG" "$MANIFEST" <<'PY'
import json, os, shutil, sys
orig, manifest_path = sys.argv[1], sys.argv[2]
home = os.path.expanduser("~")
with open(manifest_path, encoding="utf-8") as fh:
    manifest = json.load(fh)
files = {
    "monitors.lua": os.path.join(home, ".config/hypr/monitors.lua"),
    "bindings.lua": os.path.join(home, ".config/hypr/bindings.lua"),
    "shell.json": os.path.join(home, ".config/omarchy/shell.json"),
}
for key, dest in files.items():
    meta = (manifest.get("files") or {}).get(key) or {}
    src = os.path.join(orig, meta.get("name") or key)
    if meta.get("present") and os.path.isfile(src):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(src, dest)
    elif meta and not meta.get("present") and os.path.isfile(dest) and key != "shell.json":
        if key == "bindings.lua":
            pass
layouts = os.path.join(home, ".local/state/omarchy/workspace-layouts")
for key, state in (manifest.get("workspaceLayouts") or {}).items():
    try:
        n = int(str(key).strip())
    except (TypeError, ValueError):
        continue
    if n < 1 or n > 10:
        continue
    name = "%d.lua" % n
    dest = os.path.join(layouts, name)
    src = os.path.join(orig, "workspace-layouts", name)
    if state == "present" and os.path.isfile(src) and not os.path.islink(src):
        os.makedirs(layouts, exist_ok=True)
        shutil.copy2(src, dest)
    elif state == "absent" and os.path.isfile(dest) and not os.path.islink(dest):
        os.unlink(dest)
link = manifest.get("brightnessLink") or {}
path = os.path.expanduser(link.get("path") or "")
allowed = os.path.join(home, ".local/bin/omarchy-brightness-display")
if path and os.path.normpath(path) == os.path.normpath(allowed):
    previous = link.get("previous") or ""
    if link.get("state") == "absent" and os.path.islink(path):
        os.unlink(path)
    elif link.get("state") == "replaced" and previous and "\0" not in previous:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.lexists(path):
            os.unlink(path)
        os.symlink(previous, path)
plugins = os.path.join(home, ".config/omarchy/plugins")
companion = os.path.join(plugins, "im0001gt.screens.workspaces")
marker = os.path.join(companion, "generated-by-im0001gt.screens.json")
try:
    owned = os.lstat(companion).st_uid == os.getuid()
except OSError:
    owned = False
if (
    owned
    and os.path.basename(companion) == "im0001gt.screens.workspaces"
    and os.path.dirname(companion) == plugins
    and not os.path.islink(companion)
    and os.path.isdir(companion)
    and not os.path.islink(marker)
    and os.path.isfile(marker)
):
    try:
        with open(marker, encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict) and data.get("generatedBy") == "im0001gt.screens":
            shutil.rmtree(companion)
    except (OSError, json.JSONDecodeError, AttributeError, TypeError):
        pass
print("Restored first-install Hyprland and Omarchy files from", orig)
PY
hyprctl reload >/dev/null 2>&1 || true
"""
    path = restore_helper_path()
    write_private_file(path, script, mode=0o700)
    return path


def ensure_stock_backups(monitors_text=None):
    """Snapshot every stock file Screens may change. Never overwrite."""
    ensure_private_dir(BACKUP_DIR)
    ensure_private_dir(originals_dir())
    capture_monitors_original(monitors_text)
    capture_bindings_original()
    capture_shell_original()
    capture_workspace_layouts()
    capture_brightness_link()
    write_restore_helper()
    return os.path.isfile(ORIGINAL_BACKUP) or os.path.isfile(
        os.path.join(originals_dir(), "monitors.lua")
    )


def ensure_original_backup(text=None):
    """Snapshot monitors.lua once, before Screens writes it. Never overwrite."""
    return ensure_stock_backups(monitors_text=text)


def backup_file(path):
    if not os.path.isfile(path):
        return
    ensure_private_dir(BACKUP_DIR)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(BACKUP_DIR, "monitors.lua.%s" % stamp)
    shutil.copy2(path, dest)
    old = sorted(glob.glob(os.path.join(BACKUP_DIR, STAMPED_BACKUP_GLOB)))
    for extra in old[:-8]:
        try:
            os.unlink(extra)
        except OSError:
            pass


def restore_stock_file(dest, src, present):
    if present and os.path.isfile(src):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(src, dest)
        return True
    return False


def restore_original():
    ensure_stock_backups()
    orig = originals_dir()
    manifest = load_originals_manifest()
    restored = []
    monitors_src = os.path.join(orig, "monitors.lua")
    if not os.path.isfile(monitors_src) and os.path.isfile(ORIGINAL_BACKUP):
        monitors_src = ORIGINAL_BACKUP
    if os.path.isfile(monitors_src):
        if os.path.isfile(MONITORS_LUA):
            backup_file(MONITORS_LUA)
        os.makedirs(os.path.dirname(MONITORS_LUA), exist_ok=True)
        shutil.copy2(monitors_src, MONITORS_LUA)
        restored.append(MONITORS_LUA)
    files = manifest.get("files") or {}
    bindings_meta = files.get("bindings.lua") or {}
    if restore_stock_file(
        BINDINGS_LUA,
        os.path.join(orig, bindings_meta.get("name") or "bindings.lua"),
        bindings_meta.get("present", os.path.isfile(os.path.join(orig, "bindings.lua"))),
    ):
        restored.append(BINDINGS_LUA)
    elif os.path.isfile(BINDINGS_LUA) and looks_managed(read_text(BINDINGS_LUA)):
        write_private_file(BINDINGS_LUA, strip_managed_block(read_text(BINDINGS_LUA)))
        restored.append(BINDINGS_LUA)
    shell_meta = files.get("shell.json") or {}
    if restore_stock_file(
        SHELL_JSON,
        os.path.join(orig, shell_meta.get("name") or "shell.json"),
        shell_meta.get("present", os.path.isfile(os.path.join(orig, "shell.json"))),
    ):
        restored.append(SHELL_JSON)
    for key, state in (manifest.get("workspaceLayouts") or {}).items():
        name = workspace_layout_basename(key)
        if not name:
            continue
        dest = os.path.join(LAYOUTS_DIR, name)
        src = os.path.join(orig, "workspace-layouts", name)
        if state == "present" and os.path.isfile(src) and not os.path.islink(src):
            os.makedirs(LAYOUTS_DIR, exist_ok=True)
            shutil.copy2(src, dest)
            restored.append(dest)
        elif state == "absent" and os.path.isfile(dest) and not os.path.islink(dest):
            os.unlink(dest)
            restored.append(dest)
    link = manifest.get("brightnessLink") or {}
    path = os.path.expanduser(link.get("path") or BRIGHTNESS_LINK)
    expected = os.path.normpath(os.path.expanduser(BRIGHTNESS_LINK))
    previous = link.get("previous") or ""
    if os.path.normpath(path) != expected:
        path = ""
    if path and link.get("state") == "absent" and os.path.islink(path):
        os.unlink(path)
        restored.append(path)
    elif path and link.get("state") == "replaced" and previous and "\0" not in previous:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.lexists(path):
            os.unlink(path)
        os.symlink(previous, path)
        restored.append(path)
    reload_hypr()
    if remove_workspaces_plugin():
        restored.append(workspaces_plugin_dir())
    if not restored:
        print("restore-original: no first-install snapshot at %s" % orig, file=sys.stderr)
        return 2
    print("Restored pre-Screens files:")
    for item in restored:
        print("  %s" % item)
    return 0


def splice_managed(existing, block):
    if MANAGED_BEGIN in existing and MANAGED_END in existing:
        pre = existing.split(MANAGED_BEGIN, 1)[0].rstrip()
        post = existing.split(MANAGED_END, 1)[1].lstrip("\n")
        return (pre + "\n\n" + block.strip() + "\n" + (post if post.startswith("\n") else "\n" + post)).rstrip() + "\n"
    return None


def gdk_from_monitors(monitors, fallback="2"):
    scales = []
    for mon in monitors or []:
        if not mon.get("enabled", True):
            continue
        try:
            scales.append(float(mon.get("scale") or 1))
        except (TypeError, ValueError):
            pass
    if not scales:
        return str(fallback)
    return str(max(1, int(round(max(scales)))))


def write_monitors_lua(monitors, gdk=None):
    existing = ""
    if os.path.isfile(MONITORS_LUA):
        with open(MONITORS_LUA, encoding="utf-8") as fh:
            existing = fh.read()
    if gdk is None:
        if re.search(r"omarchy_gdk_scale\s*=", existing or ""):
            gdk = read_gdk_scale(existing)
        else:
            gdk = gdk_from_monitors(monitors, "2")
    inner = managed_block_lines(monitors)
    block = "\n".join(inner) + "\n"
    spliced = splice_managed(existing, block)
    if leftover_outside_managed(existing) or spliced is None:
        text = render_lua(monitors, gdk)
    else:
        text = spliced
        text = re.sub(
            r"local omarchy_gdk_scale = [0-9.]+",
            "local omarchy_gdk_scale = %s" % gdk,
            text,
            count=1,
        )
    ensure_original_backup(existing)
    backup_file(MONITORS_LUA)
    write_private_file(MONITORS_LUA, text)
    return text


def process_named(name):
    try:
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                with open(os.path.join("/proc", pid, "comm"), encoding="utf-8") as fh:
                    comm = fh.read().strip()
            except OSError:
                continue
            if comm == name:
                return True
    except OSError:
        return False
    return False


def user_unit_wanted(unit):
    wants = os.path.expanduser("~/.config/systemd/user/default.target.wants")
    return os.path.lexists(os.path.join(wants, unit))


def plugin_enabled(plugin_id):
    out = run(["omarchy-plugin-list", "--json"], timeout=8)
    if not out or out.returncode != 0 or not (out.stdout or "").strip():
        return False
    try:
        items = json.loads(out.stdout)
    except json.JSONDecodeError:
        return False
    if not isinstance(items, list):
        return False
    for item in items:
        if isinstance(item, dict) and item.get("id") == plugin_id:
            return bool(item.get("enabled", True))
    return False


def hyprmoncfg_include_active():
    """True when Hyprland still loads hyprmoncfg's generated monitor file."""
    needle = re.compile(r"hyprmoncfg-monitors", re.I)
    if hypr_lua_mode():
        return bool(needle.search(read_hypr_text(HYPRLAND_LUA)))
    return bool(needle.search(read_hypr_text(HYPRLAND_CONF)))


def hyprmoncfg_unmanaged_file():
    return os.path.isfile(HYPRMONCFG_UNMANAGED)


def hyprmoncfg_management_state():
    """True when managed, False when unmanaged, None if unknown."""
    out = run(["hyprmoncfg", "status", "--json"], timeout=8)
    if not out or out.returncode != 0 or not (out.stdout or "").strip():
        return None
    try:
        payload = json.loads(out.stdout)
    except json.JSONDecodeError:
        return None
    daemon = payload.get("daemon") if isinstance(payload, dict) else None
    if not isinstance(daemon, dict):
        return None
    if daemon.get("unmanaged") is True:
        return False
    if daemon.get("running") is True:
        return True
    return None


_conflict_cache = {"at": 0.0, "info": None}


def conflict_message(info):
    if info.get("blocking"):
        return (
            "hyprmoncfg is currently managing your displays. Screens will wait "
            "until you hand them off. Keep the plugin and turn off Managed by "
            "hyprmoncfg (or run hyprmoncfg unmanage), or remove crmne.hyprmoncfg. "
            "Screens will not do either until you pick."
        )
    return (
        "hyprmoncfg is still installed but is not managing Hyprland. "
        "You can leave it unmanaged, or remove the plugin if you do not want "
        "both on the bar."
    )


def clear_conflict_cache():
    _conflict_cache["at"] = 0.0
    _conflict_cache["info"] = None


def _lua_code_text(text):
    """Drop Lua comments so leftover -- hl.monitor lines are not treated as live."""
    if not text:
        return ""
    text = re.sub(r"--\[\[.*?\]\]", "", text, flags=re.S)
    lines = []
    for line in text.splitlines():
        out = []
        i = 0
        in_str = False
        quote = ""
        while i < len(line):
            ch = line[i]
            if in_str:
                out.append(ch)
                if ch == "\\" and i + 1 < len(line):
                    out.append(line[i + 1])
                    i += 2
                    continue
                if ch == quote:
                    in_str = False
                i += 1
                continue
            if ch in "\"'":
                in_str = True
                quote = ch
                out.append(ch)
                i += 1
                continue
            if ch == "-" and i + 1 < len(line) and line[i + 1] == "-":
                break
            out.append(ch)
            i += 1
        lines.append("".join(out))
    return "\n".join(lines)


def _conf_code_text(text):
    if not text:
        return ""
    lines = []
    for line in text.splitlines():
        lines.append(line.split("#", 1)[0])
    return "\n".join(lines)


def parse_hyprmod_lua_outputs(text):
    names = []
    clean = _lua_code_text(text)
    for match in re.finditer(r"hl\.monitor\s*\(", clean):
        brace = clean.find("{", match.end())
        if brace < 0:
            continue
        depth = 0
        end = -1
        for i, ch in enumerate(clean[brace:], brace):
            if ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    end = i
                    break
        if end < 0:
            continue
        block = clean[brace:end + 1]
        found = re.search(r"output\s*=\s*[\"']([^\"']+)[\"']", block)
        if found:
            name = found.group(1).strip()
            if name:
                names.append(name)
    return names


def parse_hyprmod_conf_outputs(text):
    names = []
    for line in _conf_code_text(text).splitlines():
        found = re.match(r"\s*monitor\s*=\s*([^,]+)", line, re.I)
        if not found:
            continue
        name = found.group(1).strip()
        if name:
            names.append(name)
    return names


def hypr_lua_mode():
    return os.path.isfile(HYPRLAND_LUA)


def read_hypr_text(path):
    if not path or not os.path.isfile(path):
        return ""
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def hyprmod_include_active():
    if hypr_lua_mode():
        text = read_hypr_text(HYPRLAND_LUA)
        return bool(re.search(r'require\(\s*["\']hyprland-gui["\']\s*\)', text))
    text = read_hypr_text(HYPRLAND_CONF)
    return bool(re.search(r"^\s*source\s*=\s*.*hyprland-gui\.conf", text, re.I | re.M))


def hyprmod_managed_outputs():
    if hypr_lua_mode():
        return parse_hyprmod_lua_outputs(read_hypr_text(HYPRMOD_GUI_LUA))
    return parse_hyprmod_conf_outputs(read_hypr_text(HYPRMOD_GUI_CONF))


def hyprmod_conflict_message(outputs):
    names = [n for n in outputs if n]
    n = len(names)
    noun = "display" if n == 1 else "displays"
    shown = ", ".join(names[:6])
    extra = " (%s)" % shown if shown else ""
    return (
        "HyprMod is managing %d %s%s. Screens will not work correctly until you "
        "open HyprMod, click the trash can next to each of those displays, and save. "
        "Screens will not remove HyprMod's monitor rules for you."
        % (n, noun, extra)
    )


def detect_hyprmoncfg():
    plugin = os.path.isdir(HYPRMONCFG_PLUGIN_DIR)
    enabled = plugin_enabled(HYPRMONCFG_PLUGIN_ID) if plugin else False
    daemon_running = process_named(HYPRMONCFG_DAEMON)
    daemon_wanted = user_unit_wanted(HYPRMONCFG_UNIT)
    package = bool(shutil.which(HYPRMONCFG_DAEMON) or shutil.which("hyprmoncfg"))
    include = hyprmoncfg_include_active()
    status = hyprmoncfg_management_state()
    unmanaged = status is False or (status is None and hyprmoncfg_unmanaged_file() and not include)
    if include or status is True:
        blocking = True
    elif unmanaged:
        blocking = False
    else:
        blocking = bool(enabled or daemon_running or daemon_wanted)
    present = bool(plugin or daemon_running or daemon_wanted or package or include)
    shown = blocking or plugin or daemon_running or daemon_wanted
    info = {
        "plugin": plugin,
        "enabled": enabled,
        "daemon": daemon_running or daemon_wanted,
        "package": package,
        "blocking": blocking,
        "unmanaged": unmanaged,
    }
    return {
        "id": HYPRMONCFG_PLUGIN_ID,
        "name": "hyprmoncfg",
        "plugin": plugin,
        "enabled": enabled,
        "daemon": daemon_running or daemon_wanted,
        "daemonActive": daemon_running,
        "package": package,
        "unmanaged": unmanaged,
        "include": include,
        "blocking": blocking,
        "present": present,
        "canUnmanage": bool(shutil.which("hyprmoncfg")),
        "canRemove": bool(plugin or package),
        "message": conflict_message(info) if shown else "",
    }


def detect_hyprmod():
    installed = bool(shutil.which("hyprmod"))
    included = hyprmod_include_active()
    outputs = hyprmod_managed_outputs() if included else []
    managing = bool(included and outputs)
    return {
        "id": "hyprmod",
        "name": "HyprMod",
        "plugin": False,
        "enabled": managing,
        "daemon": False,
        "daemonActive": False,
        "package": installed,
        "installed": installed,
        "included": included,
        "outputs": outputs,
        "blocking": managing,
        "present": managing,
        "message": hyprmod_conflict_message(outputs) if managing else "",
    }


def merge_conflicts(hyprmoncfg, hyprmod):
    choice_seen = bool(load_store().get("hyprmoncfgChoiceSeen"))
    show_hm = bool(hyprmoncfg.get("blocking") or (
        (hyprmoncfg.get("plugin") or hyprmoncfg.get("daemon")) and not choice_seen
    ))
    show_hy = bool(hyprmod.get("blocking"))
    if show_hm and show_hy:
        msg = " ".join(
            part for part in (hyprmoncfg.get("message"), hyprmod.get("message")) if part
        )
        return {
            "id": "display-managers",
            "name": "hyprmoncfg and HyprMod",
            "plugin": True,
            "enabled": True,
            "daemon": bool(hyprmoncfg.get("daemon")),
            "package": True,
            "blocking": True,
            "present": True,
            "message": msg,
            "outputs": list(hyprmod.get("outputs") or []),
        }
    if show_hy:
        return hyprmod
    return hyprmoncfg


def detect_conflicts():
    now = time.time()
    cached = _conflict_cache.get("info")
    if cached is not None and now - float(_conflict_cache.get("at") or 0) < 15:
        return cached
    info = merge_conflicts(detect_hyprmoncfg(), detect_hyprmod())
    _conflict_cache["at"] = now
    _conflict_cache["info"] = info
    return info


def public_conflict(info):
    if not info:
        return None
    blocking = bool(info.get("blocking"))
    leftover = bool((info.get("plugin") or info.get("daemon")) and not blocking)
    if leftover and load_store().get("hyprmoncfgChoiceSeen"):
        return None
    if not blocking and not leftover:
        return None
    return {
        "id": info.get("id") or "",
        "name": info.get("name") or "hyprmoncfg",
        "plugin": bool(info.get("plugin")),
        "enabled": bool(info.get("enabled")),
        "daemon": bool(info.get("daemon")),
        "package": bool(info.get("package")),
        "blocking": blocking,
        "unmanaged": bool(info.get("unmanaged")),
        "canUnmanage": bool(info.get("canUnmanage") or shutil.which("hyprmoncfg")),
        "canRemove": bool(info.get("canRemove") or info.get("plugin") or info.get("package")),
        "present": True,
        "message": info.get("message") or "",
        "outputs": list(info.get("outputs") or []),
    }


SCALE_KEY_UP_DEFAULT = "SUPER + SLASH"
SCALE_KEY_DOWN_DEFAULT = "SUPER + ALT + SLASH"
SCALE_KEY_ALTERNATES = (
    ("SUPER + CTRL + SLASH", "SUPER + CTRL + ALT + SLASH"),
    ("SUPER + CTRL + MINUS", "SUPER + CTRL + EQUAL"),
)
STOCK_SCALE_LABELS = ("Monitor scaling up", "Monitor scaling down")
STOCK_TILING_LUA = "/usr/share/omarchy/default/hypr/bindings/tiling.lua"
COMBO_TOKEN_RE = re.compile(
    r"^(SUPER|SHIFT|CTRL|CONTROL|ALT|MINUS|EQUAL|SLASH|PERIOD|COMMA|SPACE|"
    r"RETURN|TAB|ESC|ESCAPE|F([1-9]|1[0-2])|[A-Z]|[0-9])$"
)


def normalize_combo(value):
    parts = [p.strip().upper() for p in re.split(r"\s*\+\s*", str(value or "")) if p.strip()]
    out = []
    for part in parts:
        if part == "CONTROL":
            part = "CTRL"
        if part == "ESCAPE":
            part = "ESC"
        if not COMBO_TOKEN_RE.match(part):
            return ""
        out.append(part)
    if len(out) < 2 or "SUPER" not in out:
        return ""
    order = ["SUPER", "CTRL", "ALT", "SHIFT"]
    mods = [m for m in order if m in out]
    keys = [p for p in out if p not in order]
    if len(keys) != 1:
        return ""
    return " + ".join(mods + keys)


def strip_managed_bindings(text):
    if MANAGED_BEGIN not in (text or "") or MANAGED_END not in (text or ""):
        return text or ""
    pre = text.split(MANAGED_BEGIN, 1)[0]
    post = text.split(MANAGED_END, 1)[1]
    return pre + post


def parse_lua_key_actions(text):
    """Last unbind/bind for each combo in a lua bindings file."""
    actions = {}
    pattern = re.compile(
        r'hl\.unbind\(\s*"([^"]+)"\s*\)|'
        r'o\.bind\(\s*"([^"]+)"\s*,\s*"([^"]*)"(?:\s*,\s*(?:"([^"]*)"|(\{[^}]*\})))?',
        re.S,
    )
    for match in pattern.finditer(text or ""):
        if match.group(1):
            combo = normalize_combo(match.group(1))
            if combo:
                actions[combo] = {"kind": "unbind", "label": "", "command": ""}
            continue
        combo = normalize_combo(match.group(2))
        if not combo:
            continue
        actions[combo] = {
            "kind": "bind",
            "label": match.group(3) or "",
            "command": (match.group(4) or match.group(5) or ""),
        }
    return actions


def is_stock_or_screens_scale(label, command):
    cmd = str(command or "")
    lab = str(label or "")
    if "omarchy-hyprland-monitor-scaling" in cmd:
        return True
    if "im0001gt.screens" in cmd or "display-ctl scale" in cmd:
        return True
    if lab in STOCK_SCALE_LABELS:
        return True
    return False


def combo_from_hypr_bind(bind):
    if not isinstance(bind, dict):
        return ""
    mask = int(bind.get("modmask") or 0)
    key = str(bind.get("key") or "").upper()
    if not key or key in ("", "catchall"):
        return ""
    mods = []
    if mask & 64:
        mods.append("SUPER")
    if mask & 4:
        mods.append("CTRL")
    if mask & 8:
        mods.append("ALT")
    if mask & 1:
        mods.append("SHIFT")
    if not mods:
        return ""
    return normalize_combo(" + ".join(mods + [key]))


def live_scale_binds():
    raw = hypr_json(["binds"]) or []
    if not isinstance(raw, list):
        return []
    return raw


def combo_conflict(combo, user_text="", live=None):
    combo = normalize_combo(combo)
    if not combo:
        return None
    lua = parse_lua_key_actions(strip_managed_bindings(user_text)).get(combo)
    if lua and lua.get("kind") == "bind" and not is_stock_or_screens_scale(lua.get("label"), lua.get("command")):
        return {
            "combo": combo,
            "label": lua.get("label") or "",
            "command": lua.get("command") or "",
        }
    for bind in live if live is not None else live_scale_binds():
        if combo_from_hypr_bind(bind) != combo:
            continue
        desc = bind.get("description") or ""
        if is_stock_or_screens_scale(desc, ""):
            continue
        return {"combo": combo, "label": desc, "command": ""}
    return None


def scale_key_conflicts(up, down, user_text=None, live=None):
    if user_text is None:
        user_text = read_text(BINDINGS_LUA)
    found = []
    seen = set()
    for combo in (up, down):
        hit = combo_conflict(combo, user_text, live)
        if hit and hit["combo"] not in seen:
            seen.add(hit["combo"])
            found.append(hit)
    return found


def first_free_scale_alt(user_text=None, live=None):
    if user_text is None:
        user_text = read_text(BINDINGS_LUA)
    for pair in SCALE_KEY_ALTERNATES:
        if not scale_key_conflicts(pair[0], pair[1], user_text, live):
            return pair
    return SCALE_KEY_ALTERNATES[0]


def scale_keys_message(conflicts):
    if not conflicts:
        return ""
    bits = []
    for item in conflicts:
        label = item.get("label") or "a custom action"
        bits.append("%s is already bound to %s" % (item.get("combo") or "that key", label))
    return (
        "%s. Stock Display scale keys are fine to take over; this one is yours. "
        "Take Super+/ for Screens scale, pick a free pair, or keep your bind "
        "and change scale from the panel."
        % "; ".join(bits)
    )


def public_scale_keys(raw):
    src = raw if isinstance(raw, dict) else {}
    status = str(src.get("status") or "")
    if status not in ("pending", "installed", "skipped"):
        status = "installed" if looks_managed(read_text(BINDINGS_LUA)) else ""
    return {
        "status": status,
        "up": src.get("up") or SCALE_KEY_UP_DEFAULT,
        "down": src.get("down") or SCALE_KEY_DOWN_DEFAULT,
        "altUp": src.get("altUp") or SCALE_KEY_ALTERNATES[0][0],
        "altDown": src.get("altDown") or SCALE_KEY_ALTERNATES[0][1],
        "conflicts": src.get("conflicts") if isinstance(src.get("conflicts"), list) else [],
        "message": src.get("message") or "",
    }


def scale_bindings_block(up=None, down=None):
    up = normalize_combo(up) or SCALE_KEY_UP_DEFAULT
    down = normalize_combo(down) or SCALE_KEY_DOWN_DEFAULT
    path = CTL_PATH.replace("\\", "\\\\").replace('"', '\\"')
    return "\n".join([
        MANAGED_BEGIN,
        'hl.unbind("%s")' % up,
        'hl.unbind("%s")' % down,
        'o.bind("%s", "Monitor scaling up", "%s scale up")' % (up, path),
        'o.bind("%s", "Monitor scaling down", "%s scale down")' % (down, path),
        MANAGED_END,
        "",
    ])


def write_bindings_file(text):
    payload = text if text.endswith("\n") else text + "\n"
    write_private_file(BINDINGS_LUA, payload)


def install_scale_bindings(up=None, down=None):
    ensure_stock_backups()
    up = normalize_combo(up) or SCALE_KEY_UP_DEFAULT
    down = normalize_combo(down) or SCALE_KEY_DOWN_DEFAULT
    existing = read_text(BINDINGS_LUA)
    block = scale_bindings_block(up, down)
    if looks_managed(existing) and CTL_PATH in existing and up in existing and down in existing:
        return False
    if looks_managed(existing):
        text = splice_managed(existing, block) or (existing.rstrip() + "\n\n" + block)
    elif existing.strip():
        text = existing.rstrip() + "\n\n" + block
    else:
        text = (
            "-- Screens restores Omarchy's monitor scale keys after it takes over monitors.lua.\n\n"
            + block
        )
    write_bindings_file(text)
    return True


def remove_scale_bindings():
    existing = read_text(BINDINGS_LUA)
    if not looks_managed(existing):
        return False
    pre = existing.split(MANAGED_BEGIN, 1)[0].rstrip()
    post = existing.split(MANAGED_END, 1)[1].lstrip("\n")
    text = (pre + "\n" + post).strip() + "\n"
    write_bindings_file(text)
    return True


def save_scale_keys(status, up, down, conflicts=None, message="", alt=None):
    store = load_store()
    alt = alt or first_free_scale_alt()
    store["scaleKeys"] = {
        "status": status,
        "up": up,
        "down": down,
        "altUp": alt[0],
        "altDown": alt[1],
        "conflicts": conflicts or [],
        "message": message or "",
    }
    save_store(store)
    return store["scaleKeys"]


def maybe_install_scale_bindings():
    store = load_store()
    sk = store.get("scaleKeys") or {}
    status = str(sk.get("status") or "")
    existing = read_text(BINDINGS_LUA)
    if status == "skipped":
        return False
    if status == "pending":
        return False
    if status == "installed" and looks_managed(existing) and CTL_PATH in existing:
        return False
    up, down = SCALE_KEY_UP_DEFAULT, SCALE_KEY_DOWN_DEFAULT
    conflicts = scale_key_conflicts(up, down)
    if conflicts:
        alt = first_free_scale_alt()
        save_scale_keys("pending", up, down, conflicts, scale_keys_message(conflicts), alt)
        return False
    changed = install_scale_bindings(up, down)
    save_scale_keys("installed", up, down)
    return changed


def apply_scale_keys(action, up="", down=""):
    action = str(action or "").strip().lower()
    if action in ("take", "default"):
        changed = install_scale_bindings(SCALE_KEY_UP_DEFAULT, SCALE_KEY_DOWN_DEFAULT)
        save_scale_keys("installed", SCALE_KEY_UP_DEFAULT, SCALE_KEY_DOWN_DEFAULT)
        if changed:
            reload_hypr()
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if action in ("skip", "keep"):
        if remove_scale_bindings():
            reload_hypr()
        save_scale_keys("skipped", SCALE_KEY_UP_DEFAULT, SCALE_KEY_DOWN_DEFAULT)
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if action == "alt":
        pair = first_free_scale_alt()
        changed = install_scale_bindings(pair[0], pair[1])
        save_scale_keys("installed", pair[0], pair[1])
        if changed:
            reload_hypr()
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if action == "set":
        up = normalize_combo(up)
        down = normalize_combo(down)
        if not up or not down or up == down:
            print("scale-keys: need two Super+ combos", file=sys.stderr)
            return 2
        extra = scale_key_conflicts(up, down)
        if extra:
            print(
                "scale-keys: %s" % scale_keys_message(extra),
                file=sys.stderr,
            )
            return 2
        changed = install_scale_bindings(up, down)
        save_scale_keys("installed", up, down)
        if changed:
            reload_hypr()
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    print("scale-keys: take|skip|alt|set", file=sys.stderr)
    return 2


def gcd_int(a, b):
    a, b = abs(int(a)), abs(int(b))
    while b:
        a, b = b, a % b
    return a or 1


def hypr_clean_scale(scale, width, height):
    try:
        scale = float(scale)
        width = float(width)
        height = float(height)
    except (TypeError, ValueError):
        return 1.0
    if scale <= 0 or width <= 0 or height <= 0:
        return 1.0
    g = gcd_int(round(width * 120), round(height * 120))
    k = int(round(scale * 120))
    if k < 1:
        k = 1
    if k > g:
        k = g
    while g % k != 0:
        k += 1
        if k > g:
            return g / 120.0
    value = k / 120.0
    text = ("%.6f" % value).rstrip("0").rstrip(".")
    return float(text) if text else 1.0


def next_scale_preset(current, width, height, direction):
    unique = []
    seen = {}
    for preset in SCALE_PRESETS:
        effective = hypr_clean_scale(preset, width, height)
        key = round(effective, 8)
        dist = abs(preset - effective)
        if key not in seen:
            seen[key] = len(unique)
            unique.append((preset, dist, effective))
        elif dist < unique[seen[key]][1]:
            unique[seen[key]] = (preset, dist, effective)
    if not unique:
        return 1
    try:
        current = float(current)
    except (TypeError, ValueError):
        current = unique[0][2]
    best = min(range(len(unique)), key=lambda i: abs(unique[i][2] - current))
    if direction in ("up", "next"):
        best = min(best + 1, len(unique) - 1)
    elif direction in ("down", "previous"):
        best = max(best - 1, 0)
    return unique[best][0]


def scale_step(requested):
    data = snapshot()
    monitors = data.get("monitors") or []
    focused = next((m for m in monitors if m.get("focused") and m.get("enabled")), None)
    if focused is None:
        focused = next((m for m in monitors if m.get("enabled")), None)
    if focused is None:
        print("scale: no enabled display", file=sys.stderr)
        return 1
    width = focused.get("width") or 0
    height = focused.get("height") or 0
    current = focused.get("scale") or 1
    action = str(requested or "").strip().lower()
    if action in ("up", "next", "down", "previous"):
        preset = next_scale_preset(current, width, height, action)
    else:
        try:
            preset = float(requested)
        except (TypeError, ValueError):
            print("scale: up|down|SCALE", file=sys.stderr)
            return 2
        if preset < 1 or preset > 4:
            print("scale: expected 1–4", file=sys.stderr)
            return 2
    focused["scale"] = hypr_clean_scale(preset, width, height)
    focused["logicalW"], focused["logicalH"] = logical_size(
        focused.get("width"),
        focused.get("height"),
        focused.get("scale"),
        focused.get("transform"),
    )
    gdk = str(max(1, int(round(float(focused["scale"])))))
    return apply({"monitors": monitors}, gdk=gdk)


def claim_monitors(force=False):
    existing = read_text(MONITORS_LUA) if os.path.isfile(MONITORS_LUA) else ""
    ensure_original_backup(existing)
    install_workspaces_plugin()
    bindings_changed = maybe_install_scale_bindings()
    store = load_store()
    conflicts = detect_conflicts()
    leftover = leftover_outside_managed(existing)
    should_write = (
        force
        or leftover
        or not looks_managed(existing)
        or not store.get("claimedMonitors")
        or monitors_lua_needs_rewrite(existing)
    )
    wrote = False
    if should_write and not conflicts.get("blocking"):
        data = snapshot()
        monitors = data.get("monitors") or []
        if monitors:
            recover_last_internal(monitors)
            write_monitors_lua(monitors)
            sync_internal_overlay(monitors)
            wrote = True
        store = load_store()
        store["claimedMonitors"] = True
        save_store(store)
    elif not conflicts.get("blocking"):
        store["claimedMonitors"] = True
        save_store(store)
        recover_internal(quiet=True)
    if wrote or bindings_changed:
        reload_hypr()
    return {
        "ok": True,
        "wrote": wrote,
        "original": os.path.isfile(ORIGINAL_BACKUP),
        "bindings": True,
        "conflict": public_conflict(conflicts),
        "claimedMonitors": True if not conflicts.get("blocking") else bool(store.get("claimedMonitors")),
    }


def config_errors():
    out = run(["hyprctl", "configerrors"])
    if not out:
        return ""
    return (out.stdout or "").strip()


def reload_hypr():
    run(["hyprctl", "reload"])
    time.sleep(0.15)


def read_panel_state():
    try:
        with open(PANEL_STATE, encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            return {
                "wanted": bool(data.get("wanted")),
                "pendingConfirm": bool(data.get("pendingConfirm")),
                "deadline": float(data.get("deadline") or 0),
                "screen": str(data.get("screen") or ""),
            }
    except (OSError, json.JSONDecodeError, TypeError, ValueError):
        pass
    return {"wanted": False, "pendingConfirm": False, "deadline": 0.0, "screen": ""}


def write_panel_state(wanted, pending=False, deadline=0, screen=None):
    prev = read_panel_state()
    if screen is None:
        screen = prev.get("screen") or ""
    if not wanted:
        screen = ""
    payload = {
        "wanted": bool(wanted),
        "pendingConfirm": bool(pending),
        "deadline": float(deadline or 0),
        "screen": str(screen or ""),
    }
    write_private_file(PANEL_STATE, json.dumps(payload) + "\n")
    return payload


def clear_panel_state():
    return write_panel_state(False, False, 0)


def stash_revert_lua(prev_text):
    if os.path.isfile(REVERT_LUA) or not prev_text:
        return
    write_private_file(REVERT_LUA, prev_text)


def clear_pending_revert():
    try:
        os.remove(REVERT_LUA)
    except OSError:
        pass
    store = load_store()
    if store.get("pendingRevert"):
        store["pendingRevert"] = None
        save_store(store)
    st = read_panel_state()
    write_panel_state(st.get("wanted"), False, 0, st.get("screen") or "")


def confirm_layout():
    clear_pending_revert()
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def revert_layout():
    if not os.path.isfile(REVERT_LUA):
        store = load_store()
        if store.get("pendingRevert"):
            store["pendingRevert"] = None
            save_store(store)
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    shutil.copyfile(REVERT_LUA, MONITORS_LUA)
    clear_pending_revert()
    reload_hypr()
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def pending_revert_due():
    store = load_store()
    pending = store.get("pendingRevert") or {}
    if not pending:
        return False
    try:
        deadline = float(pending.get("deadline") or 0)
    except (TypeError, ValueError):
        return False
    return deadline > 0 and time.time() >= deadline


def mark_hyprmoncfg_choice_seen():
    store = load_store()
    store["hyprmoncfgChoiceSeen"] = True
    save_store(store)
    clear_conflict_cache()


def handoff_hyprmoncfg(mode):
    """User-picked handoff: unmanage, remove, or keep the leftover install."""
    action = str(mode or "").strip().lower()
    if action not in ("unmanage", "remove", "keep"):
        print("conflicts: unmanage|remove|keep", file=sys.stderr)
        return 2
    if action == "keep":
        mark_hyprmoncfg_choice_seen()
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if action == "unmanage":
        if shutil.which("hyprmoncfg"):
            run(["hyprmoncfg", "unmanage"], timeout=20)
        mark_hyprmoncfg_choice_seen()
        info = detect_conflicts()
        if not info.get("blocking"):
            claim_monitors(force=True)
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0 if not detect_conflicts().get("blocking") else 1
    if shutil.which("hyprmoncfg"):
        run(["hyprmoncfg", "unmanage"], timeout=20)
    run(["omarchy", "plugin", "remove", HYPRMONCFG_PLUGIN_ID], timeout=30)
    mark_hyprmoncfg_choice_seen()
    info = detect_conflicts()
    if not info.get("blocking"):
        claim_monitors(force=True)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0 if not detect_conflicts().get("blocking") else 1


def apply(payload, gdk=None, preview=False):
    monitors = payload.get("monitors") if isinstance(payload, dict) else None
    if not isinstance(monitors, list) or not monitors:
        print("apply: expected {\"monitors\": [...]}", file=sys.stderr)
        return 2
    conflicts = detect_conflicts()
    if conflicts.get("blocking"):
        print(
            conflicts.get("message")
            or "another display tool is managing the screens",
            file=sys.stderr,
        )
        return 2
    known = {clean_connector(m.get("name")) for m in monitors if clean_connector(m.get("name"))}
    monitors = [sanitize_monitor(m, known) for m in monitors]
    enabled = [m for m in monitors if m.get("enabled", True)]
    if not enabled:
        print("apply: refusing to disable every display", file=sys.stderr)
        return 2
    prev = ""
    if os.path.isfile(MONITORS_LUA):
        with open(MONITORS_LUA, encoding="utf-8") as fh:
            prev = fh.read()
    if preview:
        stash_revert_lua(prev)
    write_monitors_lua(monitors, gdk=gdk)
    sync_internal_overlay(monitors)
    reload_hypr()
    max_vrr = 0
    for mon in monitors:
        if mon.get("enabled", True):
            max_vrr = max(max_vrr, int(mon.get("vrr") or 0))
    run([
        "hyprctl",
        "eval",
        "hl.config({ misc = { vrr = %d }, render = { cm_auto_hdr = %d } })"
        % (max_vrr, auto_hdr_render(monitors)),
    ])
    errors = config_errors()
    if errors:
        if prev:
            write_private_file(MONITORS_LUA, prev)
            reload_hypr()
        if preview:
            clear_pending_revert()
        print(errors, file=sys.stderr)
        return 1
    prev_store = load_store()
    remember_layout(monitors)
    if not preview:
        refresh_active_profile(monitors)
    wake_new_outputs(monitors, prev_store)
    if load_store().get("manageWorkspaces"):
        pin_and_save_plan(monitors)
    else:
        write_workspaces_json(False, [], load_store().get("workspaceLayouts") or {})
    if preview:
        deadline = time.time() + 20
        store = load_store()
        store["pendingRevert"] = {"deadline": deadline}
        save_store(store)
        write_panel_state(True, True, deadline)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def was_disabled(store, identity):
    for entry in store.get("lastLayout") or []:
        if entry.get("id") == identity:
            return not entry.get("enabled", True)
    return False


def hypr_dispatch(expr):
    run(["hyprctl", "eval", "hl.dispatch(%s)" % expr])


def wake_new_outputs(monitors, prev_store):
    newly = []
    for mon in monitors:
        if not mon.get("enabled", True):
            continue
        ident = monitor_identity(mon)
        if ident and was_disabled(prev_store, ident):
            newly.append(mon)
    if not newly:
        return
    hypr_dispatch('hl.dsp.dpms({ action = "on" })')
    hypr_dispatch("hl.dsp.force_renderer_reload()")
    focused = ""
    live = hypr_json(["monitors"]) or []
    for mon in live:
        if mon.get("focused"):
            focused = mon.get("name") or ""
            break
    for mon in newly:
        name = clean_connector(mon.get("name"))
        if name:
            hypr_dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(name))
    if focused:
        hypr_dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(focused))


def profile_entry_from_monitor(mon):
    return {
        "id": monitor_identity(mon),
        "mode": mon.get("mode") or "preferred",
        "x": int(mon.get("x") or 0),
        "y": int(mon.get("y") or 0),
        "scale": mon.get("scale") if mon.get("scale") not in (None, "") else 1,
        "transform": int(mon.get("transform") or 0),
        "vrr": int(mon.get("vrr") or 0),
        "hdr": hdr_mode(mon) == 2,
        "hdrMode": hdr_mode(mon),
        "bitdepth": clean_bitdepth(mon.get("bitdepth"), 10),
        "cm": clean_cm(mon.get("cm")),
        "sdrMinLuminance": clean_float(mon.get("sdrMinLuminance"), 0.0, 1.0, 0.005),
        "sdrMaxLuminance": clean_int(mon.get("sdrMaxLuminance"), 40, 1000, 200),
        "sdrBrightness": clean_float(mon.get("sdrBrightness"), 0.5, 2.5, 1.0),
        "sdrSaturation": clean_float(mon.get("sdrSaturation"), 0.5, 2.0, 1.0),
        "sdrEotf": clean_sdr_eotf(mon.get("sdrEotf")),
        "supportsWideColor": clean_wide_color(mon.get("supportsWideColor")),
        "minLuminance": clean_float(mon.get("minLuminance"), 0.0, 10.0, -1),
        "maxLuminance": clean_int(mon.get("maxLuminance"), -1, 10000, -1),
        "maxAvgLuminance": clean_int(mon.get("maxAvgLuminance"), -1, 10000, -1),
        "textPx": clean_int(mon.get("textPx"), 0, 20, 0),
        "enabled": bool(mon.get("enabled", True)),
        "mirror": mon.get("mirror") or "",
    }


def merge_profile(profile, live):
    by_id = {monitor_identity(m): m for m in live}
    merged = []
    for live_m in live:
        rule = profile_rule(profile, live_m.get("identity") or monitor_identity(live_m))
        if not rule:
            merged.append(live_m)
            continue
        item = dict(live_m)
        for key in (
            "mode", "x", "y", "scale", "transform", "vrr", "hdr",
            "hdrMode", "bitdepth", "cm", "sdrMinLuminance", "sdrMaxLuminance",
            "sdrBrightness", "sdrSaturation", "sdrEotf", "supportsWideColor",
            "textPx", "minLuminance", "maxLuminance", "maxAvgLuminance", "enabled", "mirror",
        ):
            if key in rule:
                item[key] = rule[key]
        # Profile mirror is stored as identity; Hyprland wants a connector.
        mirror = item.get("mirror") or ""
        if mirror.startswith("desc:") and mirror in by_id:
            item["mirror"] = by_id[mirror].get("name") or ""
        elif mirror.startswith("desc:"):
            for other in live:
                if monitor_identity(other) == mirror:
                    item["mirror"] = other.get("name") or ""
                    break
        merged.append(item)
    return merged


def save_profile(name, payload=None):
    name = clean_profile_name(name)
    if not name:
        print("profile save: name must be 1-48 letters, numbers, or simple punctuation", file=sys.stderr)
        return 2
    if payload and payload.get("monitors"):
        monitors = payload["monitors"]
    else:
        monitors = snapshot()["monitors"]
    store = load_store()
    entry = {
        "name": name,
        "monitors": [profile_entry_from_monitor(m) for m in monitors if monitor_identity(m)],
    }
    others = [p for p in store["profiles"] if p.get("name") != name]
    store["profiles"] = others + [entry]
    store["active"] = name
    store["lastKey"] = connected_key(monitors)
    save_store(store)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def delete_profile(name):
    name = clean_profile_name(name)
    store = load_store()
    store["profiles"] = [p for p in store["profiles"] if p.get("name") != name]
    if store.get("active") == name:
        store["active"] = ""
    save_store(store)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def apply_profile(name):
    name = clean_profile_name(name)
    store = load_store()
    profile = find_profile(store, name)
    if not profile:
        print("profile apply: no such profile: %s" % name, file=sys.stderr)
        return 2
    live = snapshot()["monitors"]
    merged = merge_profile(profile, live)
    store["active"] = name
    store["lastKey"] = connected_key(live)
    save_store(store)
    return apply({"monitors": merged})


def set_auto(value):
    store = load_store()
    store["autoSwitch"] = str(value).strip() not in ("0", "false", "off", "no")
    save_store(store)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def read_workspaces_json():
    try:
        with open(WORKSPACES_JSON, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def workspace_labels_from(data=None):
    if data is None:
        data = read_workspaces_json()
    labels = data.get("labels")
    return labels if isinstance(labels, dict) else {}


def parse_workspace_icon(raw):
    text = str(raw or "").strip()
    if not text:
        return ""
    m = re.match(r"^(?:u\+|0x|\\\\u)?([0-9a-f]{4,6})$", text, re.I)
    if m:
        cp = int(m.group(1), 16)
        if 0 < cp <= 0x10FFFF:
            return chr(cp)
        return ""
    return text[0]


def write_workspaces_json(enabled, plan, layouts, labels=None):
    if labels is None:
        labels = workspace_labels_from()
    data = {
        "enabled": bool(enabled),
        "total": WORKSPACE_COUNT,
        "layouts": layouts or {},
        "monitors": plan or [],
        "labels": labels,
    }
    write_private_file(WORKSPACES_JSON, json.dumps(data, indent=2) + "\n")


def plan_ids_for(plan, name):
    dest = clean_connector(name)
    for item in plan or []:
        if clean_connector(item.get("name")) == dest:
            return list(item.get("ids") or [])
    return []


def clamp_focus_workspace(ws, ids):
    allowed = [str(i) for i in ids]
    if allowed:
        if str(ws) in allowed:
            return str(ws)
        return allowed[0]
    try:
        n = int(ws)
    except (TypeError, ValueError):
        return ""
    if 1 <= n <= WORKSPACE_COUNT:
        return str(n)
    return ""


def pin_workspaces(plan):
    live = hypr_json(["monitors"]) or []
    focused = ""
    focused_ws = ""
    by_name = {}
    for mon in live:
        name = mon.get("name") or ""
        by_name[name] = mon
        if mon.get("focused"):
            focused = name
            active = mon.get("activeWorkspace") or {}
            if active.get("id"):
                focused_ws = str(active.get("id"))
    for item in plan or []:
        dest = clean_connector(item.get("name"))
        ids = item.get("ids") or []
        if not dest or not ids:
            continue
        for ws in ids:
            try:
                ws = int(ws)
            except (TypeError, ValueError):
                continue
            if ws < 1 or ws > WORKSPACE_COUNT:
                continue
            hypr_dispatch(
                "hl.dsp.workspace.move({ workspace = %s, monitor = %s })"
                % (lua_str(str(ws)), lua_str(dest))
            )
    for item in plan or []:
        dest = clean_connector(item.get("name"))
        ids = item.get("ids") or []
        if not dest or dest == focused:
            continue
        live_mon = by_name.get(dest) or {}
        active = (live_mon.get("activeWorkspace") or {}).get("id")
        next_ws = clamp_focus_workspace(active, ids)
        if not next_ws:
            continue
        hypr_dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(dest))
        hypr_dispatch("hl.dsp.focus({ workspace = %s })" % lua_str(next_ws))
    if focused:
        hypr_dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(focused))
        next_ws = clamp_focus_workspace(focused_ws, plan_ids_for(plan, focused))
        if next_ws:
            hypr_dispatch("hl.dsp.focus({ workspace = %s })" % lua_str(next_ws))


def pin_and_save_plan(monitors):
    store = load_store()
    plan = plan_for_write(monitors)
    write_workspaces_json(True, plan, store.get("workspaceLayouts") or {})
    pin_workspaces(plan)
    for ws_id, mode in (store.get("workspaceLayouts") or {}).items():
        try:
            apply_layout_live(int(ws_id), mode)
        except (TypeError, ValueError):
            continue


def plugin_present(plugin_id):
    text = str(plugin_id or "")
    if not text or "/" in text or text in (".", ".."):
        return False
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", text):
        return False
    path = os.path.join(os.path.expanduser("~/.config/omarchy/plugins"), text)
    return is_owned_real_dir(path)


def bar_entry_id(entry):
    if isinstance(entry, str):
        return entry
    if isinstance(entry, dict):
        return str(entry.get("id") or "")
    return ""


def find_workspaces_slot(config):
    layout = ((config.get("bar") or {}).get("layout") or {})
    for section in ("left", "center", "right"):
        entries = layout.get(section) or []
        if not isinstance(entries, list):
            continue
        for i, entry in enumerate(entries):
            eid = bar_entry_id(entry)
            if eid.endswith(".workspaces"):
                return section, i, eid, entry
    return None, None, "", None


def load_shell_json():
    try:
        with open(SHELL_JSON, encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            return data
    except (OSError, json.JSONDecodeError):
        pass
    return None


def save_shell_json(data):
    write_private_file(SHELL_JSON, json.dumps(data, indent=2) + "\n")


def workspaces_plugin_dir():
    parent = os.path.dirname(PLUGIN_DIR.rstrip(os.sep))
    return os.path.join(parent, OUR_WS_WIDGET)


def is_expected_workspaces_path(path):
    if not path:
        return False
    dest = os.path.normpath(path)
    expected = os.path.normpath(workspaces_plugin_dir())
    return dest == expected and os.path.basename(dest) == OUR_WS_WIDGET


def is_generated_workspaces_plugin(path=None):
    dest = path or workspaces_plugin_dir()
    if not is_owned_real_dir(dest):
        return False
    marker = os.path.join(dest, WORKSPACES_PLUGIN_MARKER)
    if os.path.islink(marker) or not os.path.isfile(marker):
        return False
    try:
        with open(marker, encoding="utf-8") as fh:
            data = json.load(fh)
        return isinstance(data, dict) and data.get("generatedBy") == "im0001gt.screens"
    except (OSError, json.JSONDecodeError, AttributeError, TypeError):
        return False


def can_replace_workspaces_dir(path):
    return is_expected_workspaces_path(path) and is_generated_workspaces_plugin(path)


def can_replace_workspaces_backup(path):
    if not path or os.path.islink(path) or not os.path.isdir(path):
        return False
    dest = workspaces_plugin_dir()
    expected = os.path.normpath(dest + ".old")
    if os.path.normpath(path) != expected:
        return False
    if os.path.basename(path) != OUR_WS_WIDGET + ".old":
        return False
    if os.path.dirname(os.path.normpath(path)) != os.path.dirname(os.path.normpath(dest)):
        return False
    return is_generated_workspaces_plugin(path)


def workspace_layout_basename(key):
    try:
        n = int(str(key).strip())
    except (TypeError, ValueError):
        return ""
    if n < 1 or n > WORKSPACE_COUNT:
        return ""
    return "%d.lua" % n


def screens_plugin_version():
    path = os.path.join(PLUGIN_DIR, "manifest.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        version = str((data or {}).get("version") or "").strip()
        if version:
            return version
    except (OSError, json.JSONDecodeError, AttributeError, TypeError):
        pass
    return "1.0.0"


def workspaces_plugin_manifest():
    return {
        "schemaVersion": 1,
        "id": OUR_WS_WIDGET,
        "name": "Screens workspaces",
        "version": screens_plugin_version(),
        "author": "IM0001GT",
        "license": "MIT",
        "homepage": "https://github.com/IM0001GT/omarchy-screens",
        "description": (
            "Per-display workspaces. Right-click to name, pick an icon, "
            "or set Tile / Scroll / Float."
        ),
        "kinds": ["bar-widget"],
        "entryPoints": {"barWidget": "Workspaces.qml"},
        "barWidget": {
            "displayName": "Screens workspaces",
            "description": (
                "Per-display workspaces. Right-click to name, pick an icon, "
                "or set Tile / Scroll / Float."
            ),
            "category": "Compositor",
            "allowMultiple": False,
            "defaultSection": "left",
        },
    }


def read_bytes(path):
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except OSError:
        return None


def workspaces_plugin_files():
    files = {}
    for name in WORKSPACES_PLUGIN_FILES:
        data = read_bytes(os.path.join(PLUGIN_DIR, name))
        if data is not None:
            files[name] = data
    files["manifest.json"] = (
        json.dumps(workspaces_plugin_manifest(), indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")
    files[WORKSPACES_PLUGIN_MARKER] = (
        json.dumps({"generatedBy": "im0001gt.screens"}, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")
    return files


def workspaces_plugin_matches(dest, files):
    if not is_owned_real_dir(dest):
        return False
    try:
        existing = set(os.listdir(dest))
    except OSError:
        return False
    if existing != set(files):
        return False
    for name, data in files.items():
        if read_bytes(os.path.join(dest, name)) != data:
            return False
    return True


def install_workspaces_plugin():
    dest = workspaces_plugin_dir()
    if not is_expected_workspaces_path(dest):
        return False
    parent = os.path.dirname(dest)
    if not is_owned_real_dir(parent):
        return False
    files = workspaces_plugin_files()
    if workspaces_plugin_matches(dest, files):
        return False
    if os.path.lexists(dest) and not can_replace_workspaces_dir(dest):
        return False
    staging = tempfile.mkdtemp(prefix=".%s." % OUR_WS_WIDGET, dir=parent)
    backup = None
    moved_dest = False
    try:
        os.chmod(staging, 0o700)
        if not is_owned_real_dir(staging):
            return False
        staging_fd = os.open(staging, _dir_flags())
        try:
            for name, data in files.items():
                if os.path.basename(name) != name or name in (".", ".."):
                    return False
                flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | _nofollow_flag()
                fd = os.open(name, flags, 0o644, dir_fd=staging_fd)
                try:
                    view = memoryview(data)
                    while view:
                        written = os.write(fd, view)
                        if written <= 0:
                            raise OSError("short write")
                        view = view[written:]
                    os.fsync(fd)
                finally:
                    os.close(fd)
        finally:
            os.close(staging_fd)
        if os.path.lexists(dest):
            backup = dest + ".old"
            if os.path.lexists(backup):
                if not can_replace_workspaces_backup(backup):
                    return False
                shutil.rmtree(backup)
            os.rename(dest, backup)
            moved_dest = True
        os.rename(staging, dest)
        staging = None
        leftover = dest + ".old"
        if can_replace_workspaces_backup(leftover):
            shutil.rmtree(leftover)
        return True
    except OSError:
        if moved_dest and backup and not os.path.lexists(dest) and is_owned_real_dir(backup):
            try:
                os.rename(backup, dest)
            except OSError:
                pass
        return False
    finally:
        if staging and is_owned_real_dir(staging):
            base = os.path.basename(staging)
            if base.startswith(".%s." % OUR_WS_WIDGET):
                shutil.rmtree(staging)


def remove_workspaces_plugin():
    dest = workspaces_plugin_dir()
    if not can_replace_workspaces_dir(dest):
        return False
    shutil.rmtree(dest)
    return True


def swap_bar_workspaces(enable):
    ensure_stock_backups()
    config = load_shell_json()
    if not config:
        return
    section, index, eid, entry = find_workspaces_slot(config)
    if section is None:
        return
    store = load_store()
    if enable:
        if eid == OUR_WS_WIDGET:
            return
        store["workspacesBarId"] = eid or STOCK_WS_WIDGET
        save_store(store)
        new_id = OUR_WS_WIDGET
    else:
        if eid != OUR_WS_WIDGET:
            return
        new_id = store.get("workspacesBarId") or STOCK_WS_WIDGET
        if new_id == OUR_WS_WIDGET or not plugin_present(new_id):
            new_id = STOCK_WS_WIDGET
    if isinstance(entry, str):
        config["bar"]["layout"][section][index] = new_id
    elif isinstance(entry, dict):
        next_entry = dict(entry)
        next_entry["id"] = new_id
        config["bar"]["layout"][section][index] = next_entry
    else:
        return
    save_shell_json(config)


def snapshot_monitors_for_write():
    live = snapshot()["monitors"]
    known = {clean_connector(m.get("name")) for m in live if clean_connector(m.get("name"))}
    return [sanitize_monitor(m, known) for m in live]


def set_manage_workspaces(on):
    store = load_store()
    store["manageWorkspaces"] = bool(on)
    save_store(store)
    live = snapshot_monitors_for_write()
    write_monitors_lua(live)
    reload_hypr()
    if on:
        pin_and_save_plan(live)
        install_workspaces_plugin()
        swap_bar_workspaces(True)
    else:
        write_workspaces_json(False, saved_plan() or [], store.get("workspaceLayouts") or {})
        swap_bar_workspaces(False)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def sync_workspaces():
    store = load_store()
    if not store.get("manageWorkspaces"):
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    live = snapshot_monitors_for_write()
    write_monitors_lua(live)
    reload_hypr()
    pin_and_save_plan(live)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def write_layout_file(ws_id, mode):
    ensure_stock_backups()
    os.makedirs(LAYOUTS_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(LAYOUTS_DIR, "%d.lua" % ws_id)
    hypr_layout = "scrolling" if mode == "scroll" else "dwindle"
    lines = [
        'hl.workspace_rule({ workspace = "%d", layout = "%s" })' % (ws_id, hypr_layout),
    ]
    if mode == "float":
        lines.append(
            'hl.window_rule({ name = %s, match = { workspace = "%d" }, float = true })'
            % (lua_str("im0001gt.screens-float-%d" % ws_id), ws_id)
        )
    write_private_file(path, "\n".join(lines) + "\n")


def float_windows_on_workspace(ws_id, floating):
    clients = hypr_json(["clients"]) or []
    action = "on" if floating else "off"
    for client in clients:
        ws = client.get("workspace") or {}
        try:
            cid = int(ws.get("id") or 0)
        except (TypeError, ValueError):
            continue
        if cid != ws_id:
            continue
        addr = str(client.get("address") or "")
        if not addr:
            continue
        if not addr.startswith("address:"):
            addr = "address:%s" % addr
        hypr_dispatch(
            "hl.dsp.window.float({ action = %s, window = %s })"
            % (lua_str(action), lua_str(addr))
        )


def apply_layout_live(ws_id, mode):
    hypr_layout = "scrolling" if mode == "scroll" else "dwindle"
    run(
        [
            "hyprctl",
            "eval",
            'hl.workspace_rule({ workspace = "%d", layout = "%s" })' % (ws_id, hypr_layout),
        ]
    )
    rule_name = "im0001gt.screens-float-%d" % ws_id
    if mode == "float":
        run(
            [
                "hyprctl",
                "eval",
                "hl.window_rule({ name = %s, match = { workspace = \"%d\" }, float = true })"
                % (lua_str(rule_name), ws_id),
            ]
        )
        float_windows_on_workspace(ws_id, True)
        return
    run(
        [
            "hyprctl",
            "eval",
            "hl.window_rule({ name = %s, match = { workspace = \"%d\" }, tile = true })"
            % (lua_str(rule_name), ws_id),
        ]
    )
    float_windows_on_workspace(ws_id, False)


def set_workspace_layout(ws_id, mode):
    try:
        ws_id = int(ws_id)
    except (TypeError, ValueError):
        print("workspace-layout: workspace must be 1-10", file=sys.stderr)
        return 2
    if ws_id < 1 or ws_id > WORKSPACE_COUNT:
        print("workspace-layout: workspace must be 1-10", file=sys.stderr)
        return 2
    mode = clean_workspace_layout(mode)
    if not mode:
        print("workspace-layout: tile|scroll|float", file=sys.stderr)
        return 2
    store = load_store()
    layouts = dict(store.get("workspaceLayouts") or {})
    layouts[str(ws_id)] = mode
    store["workspaceLayouts"] = layouts
    save_store(store)
    write_layout_file(ws_id, mode)
    apply_layout_live(ws_id, mode)
    if store.get("manageWorkspaces"):
        live = snapshot()["monitors"]
        write_workspaces_json(True, plan_for_write(live), layouts)
    else:
        write_workspaces_json(False, [], layouts)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def set_workspace_label(ws_id, name="", icon=""):
    try:
        n = int(str(ws_id).strip())
    except (TypeError, ValueError):
        n = 0
    if n < 1 or n > WORKSPACE_COUNT:
        print("workspace-label: workspace must be 1-10", file=sys.stderr)
        return 2
    data = read_workspaces_json()
    labels = dict(workspace_labels_from(data))
    name = " ".join(str(name or "").split())[:48]
    icon = parse_workspace_icon(icon)
    key = str(n)
    if not name and not icon:
        labels.pop(key, None)
    else:
        labels[key] = {"name": name, "icon": icon}
    write_workspaces_json(
        bool(data.get("enabled")),
        data.get("monitors") if isinstance(data.get("monitors"), list) else [],
        data.get("layouts") if isinstance(data.get("layouts"), dict) else {},
        labels,
    )
    return 0


def set_primary(identity):
    store = load_store()
    store["primary"] = (identity or "").strip()
    save_store(store)
    if store.get("manageWorkspaces"):
        live = snapshot()["monitors"]
        write_monitors_lua(live)
        reload_hypr()
        pin_and_save_plan(live)
    print(json.dumps(snapshot(), separators=(",", ":")))
    return 0


def enable_output(name):
    want = (name or "").strip()
    if not want:
        print("enable: missing output name", file=sys.stderr)
        return 2
    data = snapshot()
    monitors = data.get("monitors") or []
    found = None
    for mon in monitors:
        if mon.get("name") == want or mon.get("identity") == want:
            found = mon
            break
    if not found:
        print("enable: no such display: %s" % want, file=sys.stderr)
        return 2
    found["enabled"] = True
    store = load_store()
    if store.get("autoSwitch", True):
        ids = [m.get("identity") for m in monitors if m.get("enabled", True) and m.get("identity")]
        match = match_profile(store, ids)
        if match:
            return apply_profile(match)
    return apply({"monitors": monitors})


def unmirror():
    data = snapshot()
    monitors = data.get("monitors") or []
    for mon in monitors:
        mon["mirror"] = ""
    restore_desk_geometry(monitors)
    return apply({"monitors": monitors})


def identify(name=None):
    data = snapshot()
    targets = data["monitors"]
    if name:
        targets = [m for m in targets if m["name"] == name]
    if not targets:
        return 1
    for i, mon in enumerate(targets, start=1):
        label = "%d  %s  %s" % (i, mon["name"], mon["label"])
        run(["hyprctl", "notify", "-1", "2200", "0", "fontsize:22 %s" % label])
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    if cmd == "state":
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if cmd == "backup-original":
        ensure_stock_backups()
        orig = originals_dir()
        if os.path.isdir(orig):
            print(orig)
            return 0
        print("backup-original: could not snapshot stock files", file=sys.stderr)
        return 1
    if cmd == "restore-original":
        return restore_original()
    if cmd == "confirm":
        return confirm_layout()
    if cmd == "panel-state":
        action = argv[1] if len(argv) > 1 else ""
        if action in ("open", "wanted"):
            write_panel_state(True, True, time.time() + 20)
            return 0
        clear_panel_state()
        return 0
    if cmd == "revert":
        return revert_layout()
    if cmd == "revert-if-due":
        if pending_revert_due():
            return revert_layout()
        return 0
    if cmd == "apply":
        args = argv[1:]
        preview = False
        if args and args[0] in ("--preview", "preview"):
            preview = True
            args = args[1:]
        raw = args[0] if args else sys.stdin.read()
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError as exc:
            print("apply: bad json: %s" % exc, file=sys.stderr)
            return 2
        return apply(payload, preview=preview)
    if cmd == "enable":
        return enable_output(argv[1] if len(argv) > 1 else "")
    if cmd == "unmirror":
        return unmirror()
    if cmd == "identify":
        return identify(argv[1] if len(argv) > 1 else None)
    if cmd == "profile":
        if len(argv) < 2:
            print("profile: save|delete|apply|auto", file=sys.stderr)
            return 2
        action = argv[1]
        if action == "save":
            raw = argv[3] if len(argv) > 3 else None
            payload = json.loads(raw) if raw else None
            return save_profile(argv[2] if len(argv) > 2 else "", payload)
        if action == "delete":
            return delete_profile(argv[2] if len(argv) > 2 else "")
        if action == "apply":
            return apply_profile(argv[2] if len(argv) > 2 else "")
        if action == "auto":
            return set_auto(argv[2] if len(argv) > 2 else "1")
        if action == "primary":
            return set_primary(argv[2] if len(argv) > 2 else "")
        print("profile: unknown action: %s" % action, file=sys.stderr)
        return 2
    if cmd == "workspaces":
        action = argv[1] if len(argv) > 1 else ""
        if action in ("on", "1", "true"):
            return set_manage_workspaces(True)
        if action in ("off", "0", "false"):
            return set_manage_workspaces(False)
        if action == "auto":
            return auto_workspaces()
        if action in ("sync", "rebalance"):
            return sync_workspaces()
        if action == "plan":
            return report_workspace_plan()
        if action == "assign":
            raw = argv[2] if len(argv) > 2 else sys.stdin.read()
            try:
                payload = json.loads(raw)
            except json.JSONDecodeError as exc:
                print("workspaces assign: bad json: %s" % exc, file=sys.stderr)
                return 2
            return assign_workspaces(payload)
        print("workspaces: on|off|sync|auto|assign <json>|plan", file=sys.stderr)
        return 2
    if cmd == "workspace-layout":
        return set_workspace_layout(
            argv[1] if len(argv) > 1 else "",
            argv[2] if len(argv) > 2 else "",
        )
    if cmd == "workspace-label":
        return set_workspace_label(
            argv[1] if len(argv) > 1 else "",
            argv[2] if len(argv) > 2 else "",
            argv[3] if len(argv) > 3 else "",
        )
    if cmd == "idle":
        action = argv[1] if len(argv) > 1 else ""
        if action == "off":
            return idle_off()
        if action == "on":
            return idle_on()
        if action == "notice":
            return notice_seen()
        print("idle: off|on|notice", file=sys.stderr)
        return 2
    if cmd == "claim":
        print(json.dumps(claim_monitors(), separators=(",", ":")))
        return 0
    if cmd == "recover-internal":
        return recover_internal()
    if cmd == "conflicts":
        action = argv[1] if len(argv) > 1 else ""
        if action in ("unmanage", "remove", "keep"):
            return handoff_hyprmoncfg(action)
        info = detect_conflicts()
        payload = public_conflict(info) or {"present": False, "blocking": False}
        if action in ("--check", "check"):
            if payload.get("present"):
                print(json.dumps(payload, separators=(",", ":")))
                return 1
            return 0
        print(json.dumps(payload, separators=(",", ":")))
        return 1 if payload.get("present") else 0
    if cmd == "bar-care":
        return set_bar_care(
            argv[1] if len(argv) > 1 else "",
            argv[2] if len(argv) > 2 else "",
        )
    if cmd == "scale-keys":
        return apply_scale_keys(
            argv[1] if len(argv) > 1 else "",
            argv[2] if len(argv) > 2 else "",
            argv[3] if len(argv) > 3 else "",
        )
    if cmd == "scale":
        return scale_step(argv[1] if len(argv) > 1 else "")
    print("unknown command: %s" % cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
